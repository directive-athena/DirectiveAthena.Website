{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "lib": ["DOM", "ES2020"],
        "rootDir": "src/DirectiveAthena.Website/wwwroot/ts",
        "outDir": "src/DirectiveAthena.Website/wwwroot/js",
        "noEmitOnError": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src/DirectiveAthena.Website/wwwroot/ts/**/*.ts",
        "src/DirectiveAthena.Website/wwwroot/ts/**/*.d.ts"
    ]
}
