@namespace DirectiveAthena.Website.Components

<MudThemeProvider Theme="_theme" DefaultScrollbar="true" IsDarkMode="true" />

@code {
    private readonly MudTheme _theme = new() {
        PaletteDark = new PaletteDark {
            Primary = "#802040",
            Secondary = "#00E5FF",
            Tertiary = "#4A148C",
            Info = "#00B0FF",
            Success = "#1f995e",
            Warning = "#b37406",
            Error = "#FF1744",
            AppbarBackground = "rgba(10, 14, 28, 0.7)",
            AppbarText = "#FFFFFF",
            Background = "#0A0E1C",
            Surface = "#111827",
            DrawerBackground = "#0A0E1C",
            DrawerText = "#FFFFFF",
            TextPrimary = "#F9FAFB",
            TextSecondary = "#9CA3AF",
            ActionDefault = "#00E5FF",
            ActionDisabled = "rgba(255,255,255, 0.26)",
            ActionDisabledBackground = "rgba(255,255,255, 0.12)",
            Divider = "rgba(255,255,255, 0.12)"
        },
        Typography = new Typography {
            Default = new DefaultTypography {
                FontFamily = ["Inter", "Roboto", "Helvetica", "Arial", "sans-serif"]
            },
            H1 = new H1Typography { FontFamily = ["Space Grotesk", "sans-serif"], FontSize = "4rem", FontWeight = "700", LetterSpacing = "-0.02em" },
            H2 = new H2Typography { FontFamily = ["Space Grotesk", "sans-serif"], FontSize = "3rem", FontWeight = "700" },
            H3 = new H3Typography { FontFamily = ["Space Grotesk", "sans-serif"], FontSize = "2rem", FontWeight = "600" },
            H4 = new H4Typography { FontFamily = ["Space Grotesk", "sans-serif"], FontSize = "1.5rem", FontWeight = "600" },
            Button = new ButtonTypography { FontFamily = ["Space Grotesk", "sans-serif"], FontWeight = "600", LetterSpacing = "0.05em", TextTransform = "uppercase" }
        },
        LayoutProperties = new LayoutProperties {
            DefaultBorderRadius = "8px"
        }
    };
}
