@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Articles
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/articles"

@inject IArticleRepository ArticleRepository
@inject IArticleManager ArticleManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Shared> LocalizerShared
@inject IStringLocalizer<Tags> LocalizerTags
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@LocalizerShared[Shared.WritingsTitle]</PageTitle>

<div class="min-vh-100 py-32">
    <MudContainer MaxWidth="MaxWidth.Large">
        @* Archive View *@
        <div class="text-center mb-16">
            <MudText Typo="Typo.h2" Class="mb-4">@LocalizerShared[Shared.WritingsArchiveTitle]</MudText>
            <MudText Typo="Typo.body1" Class="text-secondary opacity-70">@LocalizerShared[Shared.WritingsArchiveSubtitle]
            </MudText>
        </div>

        <div class="d-flex flex-wrap justify-center gap-2 mb-12">
            <MudChip T="string" Variant="@(string.IsNullOrEmpty(_selectedTag) ? Variant.Filled : Variant.Outlined)"
                     Color="Color.Secondary" OnClick="@ClearTag">@LocalizerShared[Shared.WritingsArchiveAllPosts]
            </MudChip>
            @if (_posts is not null) {
                foreach (string tag in _posts.SelectMany(p => p.Tags).Distinct()) {
                    <MudChip T="string" Variant="@(_selectedTag == tag ? Variant.Filled : Variant.Outlined)"
                             Color="Color.Secondary"
                             OnClick="@(() => FilterByTag(tag))">@LocalizerTags[tag])</MudChip>
                }
            }
        </div>

        @if (_posts is null) {
            <div class="d-flex justify-center py-12">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large"/>
            </div>
        }
        else {
            <MudGrid Spacing="6">
                @foreach (Article post in FilteredPosts) {
                    <MudItem xs="12" md="6">
                        <MudCard Class="card-glass h-100 d-flex flex-column" @onclick="@(() => ViewPost(post.Id))"
                                 Style="cursor: pointer;">
                            <MudCardContent Class="flex-grow-1 pa-8">
                                <div class="d-flex justify-space-between align-center mb-4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                             Style="letter-spacing: 0.1em; text-transform: uppercase;">@post.Date</MudText>
                                    <div class="d-flex gap-1">
                                        @foreach (string tag in post.Tags.Take(2)) {
                                            <span class="px-2 py-0 rounded"
                                                  style="background: rgba(0, 229, 255, 0.1); color: var(--neon-cyan); font-size: 0.7rem; border: 1px solid rgba(0, 229, 255, 0.2);">@LocalizerTags[tag]</span>
                                        }
                                    </div>
                                </div>
                                <MudText Typo="Typo.h4"
                                         Class="mb-4 SpaceGrotesk">@ArticleManager.GetLocalizedTitle(post)</MudText>
                                <MudText Typo="Typo.body2" Class="text-secondary mb-6"
                                         Style="line-height: 1.6;">
                                    @ArticleManager.GetLocalizedSummary(post)
                                </MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Secondary"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           Class="pa-0">@LocalizerShared[Shared.WritingsArchiveReadArticle]
                                </MudButton>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudContainer>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private Article[]? _posts;
    private string? _selectedTag;

    protected override async Task OnInitializedAsync() {
        IEnumerable<Article> posts = await ArticleRepository.GetAllWithoutHiddenAsync();
        _posts = posts.ToArray() ;
    }

    private IEnumerable<Article> FilteredPosts =>
        string.IsNullOrEmpty(_selectedTag)
            ? _posts ?? []
            : (_posts ?? []).Where(p => p.Tags.Contains(_selectedTag));

    private void FilterByTag(string tag) => _selectedTag = tag;
    private void ClearTag() => _selectedTag = null;

    private void ViewPost(Guid id) {
        NavigationManager.NavigateTo($"/articles/{id:D}");
    }
}
