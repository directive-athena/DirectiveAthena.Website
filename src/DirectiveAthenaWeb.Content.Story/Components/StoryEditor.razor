@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Content
@using DirectiveAthenaWeb.Services.ContentStorage
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Content.Story
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStoryContentManager StoryManager
@inject IContentStorageFactory ContentStorageFactory
@inject IStringLocalizer<Shared> Localizer

@inherits ContentEditorComponentBase<StoryContent>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<ContentEditor TContent="StoryContent" Content="@Story"
               Tags="@Story.Tags"
               HeaderText="@string.Format(Localizer[Shared.EditorEditStory], Story.Id.ToString("D"))"
               IdHelperText="@Localizer[Shared.EditorIdHelperStory]"
               MarkdownFileLabel="@string.Format(Localizer[Shared.EditorMarkdownFileLabel], "story.md")"
               MarkdownFileHelper="@Localizer[Shared.EditorMarkdownFileHelper]"
               MarkdownTitle="@Localizer[Shared.MarkdownLabel]"
               SoftDeleteConfirmText="@Localizer[Shared.ContentManagerDeleteStorySoftConfirm]"
               SoftDeleteSuccessText="@Localizer[Shared.ContentManagerDeleteStorySoftSuccess]"
               SoftDeleteFailedText="@Localizer[Shared.ContentManagerDeleteStorySoftFailed]"
               HardDeleteConfirmText="@Localizer[Shared.ContentManagerDeleteStoryHardConfirm]"
               HardDeleteSuccessText="@Localizer[Shared.ContentManagerDeleteStoryHardSuccess]"
               HardDeleteFailedText="@Localizer[Shared.ContentManagerDeleteStoryHardFailed]"
               Storage="@_storage"
               LoadContentAsync="@((string locale) => StoryManager.GetRawMarkdownContentAsync(Story, locale))"
               BuildDefaultContent="@BuildDefaultMarkdown"
               OnGenerateStubs="OnGenerateStubs"
               OnTagsChanged="OnTagsChanged"
               OnContentChanged="OnContentChanged"
               OnDeleted="OnDeleted"
               ShowHiddenToggle="true">
    <AdditionalFields>
        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.subtitle1" Color="Color.Primary">@Localizer[Shared.EditorChaptersTitle]</MudText>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (string chapter in Story.Chapters) {
                    <MudChip T="string" OnClose="@(() => RemoveChapter(chapter))" Color="Color.Secondary"
                             Variant="Variant.Filled">@chapter</MudChip>
                }
            </div>
            <div class="d-flex gap-2">
                <MudTextField @bind-Value="_newChapter" Label="@Localizer[Shared.EditorAddChapter]"
                              OnKeyDown="@OnChapterKey"/>
                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="@AddChapter"/>
            </div>
            <MudText Typo="Typo.caption" Class="mt-1 d-block">
                @Localizer[Shared.EditorChaptersHint]
            </MudText>
        </MudItem>
    </AdditionalFields>
    <LocalizedFields Context="culture">
        <MudTextField Value="@GetTitle(culture.Code)"
                      ValueChanged="@((string s) => SetTitle(culture.Code, s))"
                      Label="@($"{Localizer[Shared.EditorTitleLabel]} ({culture.Code})")"
                      Required="@(LocalizationProvider.IsDefaultCultureCode(culture.Code))"/>
        <MudTextField Value="@GetSummary(culture.Code)"
                      ValueChanged="@((string s) => SetSummary(culture.Code, s))"
                      Label="@($"{Localizer[Shared.EditorSummaryLabel]} ({culture.Code})")"
                      Required="@(LocalizationProvider.IsDefaultCultureCode(culture.Code))" Lines="3"/>
    </LocalizedFields>
</ContentEditor>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter, EditorRequired] public StoryContent Story { get => Content; set => Content = value; }
    [Parameter] public EventCallback<bool> OnGenerateStubs { get; set; }
    [Parameter] public EventCallback<ContentDeleteResult<StoryContent>> OnDeleted { get; set; }

    private IContentStorage _storage = null!;
    private string _newChapter = "";

    protected override void OnInitialized() {
        _storage = ContentStorageFactory.ForCategory("story");
    }

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    private string GetTitle(string culture)
        => Story.Title.GetValueOrDefault(culture) ?? "";
    private void SetTitle(string culture, string value)
        => SetLocalizedValue(Story.Title, culture, value);

    private string GetSummary(string culture)
        => Story.Summary.GetValueOrDefault(culture) ?? "";
    private void SetSummary(string culture, string value)
        => SetLocalizedValue(Story.Summary, culture, value);

    private void AddChapter() {
        if (string.IsNullOrWhiteSpace(_newChapter)) return;

        string trimmedChapter = _newChapter.Trim();
        if (Story.Chapters.Contains(trimmedChapter)) {
            _newChapter = "";
            return;
        }

        Story.Chapters.Add(trimmedChapter);
        TouchLastModified();
        NotifyContentChanged();
        _newChapter = "";
    }

    private void RemoveChapter(string chapter) {
        Story.Chapters.Remove(chapter);
        TouchLastModified();
        NotifyContentChanged();
    }

    private void OnChapterKey(KeyboardEventArgs e) {
        if (e.Key == "Enter") AddChapter();
    }

    private string BuildDefaultMarkdown(string locale) {
        string title = Story.Title.GetValueOrDefault(locale) ?? Localizer[Shared.EditorNewStoryTitle];
        string summary = Story.Summary.GetValueOrDefault(locale) ?? "";
        return $"# {title}\n\n{summary}";
    }

}
