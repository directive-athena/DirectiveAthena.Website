@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Content.Story
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<ContentList TContent="StoryContent"
             Items="Stories"
             SelectedItem="SelectedStory"
             OnSelected="OnStorySelected"
             OnCreate="OnCreateStory"
             HeaderText="@Localizer[Shared.ListStories]"
             GetTitle="GetTitle"
             LocalizationMaps="GetLocalizationMaps"
             ShowHiddenChip="true"/>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public List<StoryContent>? Stories { get; set; }
    [Parameter] public StoryContent? SelectedStory { get; set; }
    [Parameter] public EventCallback<StoryContent?> OnStorySelected { get; set; }
    [Parameter] public EventCallback OnCreateStory { get; set; }

    private string GetTitle(StoryContent story)
        => story.Title.GetValueOrDefault("en") ?? Localizer[Shared.ListUntitled];

    private IEnumerable<Dictionary<string, string>> GetLocalizationMaps(StoryContent story)
        => [story.Title, story.Summary];
}
