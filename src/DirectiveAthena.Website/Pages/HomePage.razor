@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Resources
@using Microsoft.Extensions.Localization
@using DirectiveAthena.Website.Components

@namespace DirectiveAthena.Website.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/"
@inject IStringLocalizer<Shared> Localizer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@Localizer[Shared.HomeTitle]</PageTitle>

<MudStack Spacing="8">
    <Hero />

    <MudSpacer/>

    <section id="writings" class="py-32">
        <MudContainer MaxWidth="MaxWidth.Large">
            <div class="d-flex justify-space-between align-end mb-12">
                <div>
                    <MudText Typo="Typo.h2" Class="mb-4">@Localizer[Shared.HomeWritingsTitle]</MudText>
                    <MudText Typo="Typo.body1" Class="text-secondary opacity-70">@Localizer[Shared.HomeWritingsSubtitle]</MudText>
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="/articles"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           Class="d-none d-sm-flex">@Localizer[Shared.HomeWritingsViewArchive]</MudButton>
            </div>

            <MudGrid Spacing="6">
                <MudItem xs="12">
                    <ArticleLatestHighlight />
                </MudItem>
                <ArticleRecentGrid />
            </MudGrid>
            
            <div class="d-flex justify-center mt-12 d-sm-none">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           Href="/articles">@Localizer[Shared.HomeWritingsViewAll]</MudButton>
            </div>
        </MudContainer>
    </section>

    <MudSpacer/>

    <TwitchSection/>
</MudStack>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@