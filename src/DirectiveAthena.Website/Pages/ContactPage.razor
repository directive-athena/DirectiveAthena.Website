@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Resources
@using DirectiveAthena.Website.Services.Contact
@using Microsoft.Extensions.Localization

@namespace DirectiveAthena.Website.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/contact"

@inject IStringLocalizer<Shared> Localizer
@inject IContactInfoProvider ContactInfoProvider
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@Localizer[Shared.ContactTitle]</PageTitle>

<div class="min-vh-100 py-32 d-flex align-center">
    <MudContainer MaxWidth="MaxWidth.Small" Class="text-center">
        <MudText Typo="Typo.h2" Class="mb-6">@Localizer[Shared.ContactHeading]</MudText>
        <MudText Typo="Typo.body1" Class="text-secondary mb-12">
            @Localizer[Shared.ContactSubtitle]
        </MudText>

        <MudGrid Spacing="4">
            @foreach (ContactInfo contactInfo in ContactInfoProvider.GetContactInfos()) {
                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@contactInfo.Icon" Href="@contactInfo.Url" Target="_blank"
                               Class="py-4 card-glass">
                        @contactInfo.Title
                    </MudButton>
                </MudItem>
            }
        </MudGrid>

        <div class="mt-16">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="/"
                       StartIcon="@Icons.Material.Filled.ArrowBack">@Localizer[Shared.ContactReturn]
            </MudButton>
        </div>
    </MudContainer>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

