@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthena.Website.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/contact"

@inject IStringLocalizer<Shared> Localizer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@Localizer["Contact.Title"]</PageTitle>

<div class="min-vh-100 py-32 d-flex align-center">
    <MudContainer MaxWidth="MaxWidth.Small" Class="text-center">
        <MudText Typo="Typo.h2" Class="mb-6">@Localizer["Contact.Heading"]</MudText>
        <MudText Typo="Typo.body1" Class="text-secondary mb-12">
            @Localizer["Contact.Subtitle"]
        </MudText>

        <MudGrid Spacing="4">
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Custom.Brands.X" Href="https://x.com/AnnaSasDev"
                           Target="_blank" Class="py-4 card-glass">
                    Twitter / X
                </MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Surface" FullWidth="true"
                           StartIcon="@Icons.Custom.Brands.GitHub" Href="https://github.com/directive-athena/Website" Target="_blank"
                           Class="py-4 card-glass">
                    GitHub - Directive Athena Website
                </MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Surface" FullWidth="true"
                           StartIcon="@Icons.Custom.Brands.GitHub" Href="https://github.com/AnnaSasDev" Target="_blank"
                           Class="py-4 card-glass">
                    GitHub - AnnaSasDev
                </MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Computer" Href="https://twitch.tv/AnnaSasDev"
                           Target="_blank" Class="py-4 card-glass">
                    Twitch
                </MudButton>
            </MudItem>
        </MudGrid>

        <div class="mt-16">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="/"
                       StartIcon="@Icons.Material.Filled.ArrowBack">@Localizer["Contact.Return"]
            </MudButton>
        </div>
    </MudContainer>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
