@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Components
@using DirectiveAthena.Website.Services.FileSystem
@using DirectiveAthena.Website.Services.WorldRules

@namespace DirectiveAthena.Website.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/world-rules-manager"
@page "/faq-manager"

@inject IWorldRuleRepository WorldRuleRepository
@inject IWorldRuleManager WorldRuleManager
@inject IDevFileSystemManager DevFileSystemManager
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>World Rules Manager - Directive Athena</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-12">
    <div class="d-flex justify-space-between align-center mb-8">
        <MudText Typo="Typo.h3">World Rules Manager</MudText>

        @if (DevFileSystemManager.IsLocalhost) {
            <div class="d-flex align-center gap-4">
                @if (_fsSupported) {
                    <MudChip T="string" Color="@(_hasAccess ? Color.Success : Color.Warning)"
                             Icon="@(_hasAccess ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)">
                        Write Access: @(_hasAccess ? "Granted" : "Required")
                    </MudChip>
                    if (!_hasAccess) {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@RequestAccess">Grant
                            Access
                        </MudButton>
                    }
                    else {
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                   OnClick="@ResetAccess">Reset Access
                        </MudButton>
                    }
                }
                else {
                    <MudAlert Severity="Severity.Error" Dense="true">FS API Not Supported</MudAlert>
                }
            </div>
        }
    </div>

    @if (_rules is null) {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    }
    else {
        if (!DevFileSystemManager.IsLocalhost) {
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-6">
                <b>Read-Only Mode:</b> Direct filesystem writes are only available on <code>localhost</code> and in
                <code>DEBUG</code> mode.
            </MudAlert>
        }
        else {
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <MudTabPanel Text="Rules" Icon="@Icons.Material.Filled.Rule">
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <WorldRuleList Rules="_rules" SelectedRule="_selectedRule"
                                           OnRuleSelected="OnRuleSelected" OnCreateRule="CreateNewRule"/>

                            @switch (DevFileSystemManager.IsLocalhost) {
                                case true when _hasAccess:
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                               OnClick="@SaveAll"
                                               StartIcon="@Icons.Material.Filled.Save" Class="mb-4">
                                        Save index.json
                                    </MudButton>
                                    break;
                                case false:
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                               OnClick="@ExportJson"
                                               StartIcon="@Icons.Material.Filled.Download" Class="mb-4">
                                        Download index.json
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true"
                                               OnClick="@CopyJson"
                                               StartIcon="@Icons.Material.Filled.ContentCopy">
                                        Copy index.json to Clipboard
                                    </MudButton>
                                    break;
                            }
                        </MudItem>

                        <MudItem xs="12" md="8">
                            @if (_selectedRule is not null) {
                                <WorldRuleEditor Rule="_selectedRule" OnDeleteRule="DeleteRule"
                                                 OnGenerateStubs="GenerateStubs"/>
                            }
                            else {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Select a rule or create a
                                    new
                                    one.
                                </MudAlert>
                            }
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Markdown" Icon="@Icons.Material.Filled.EditNote">
                    <WorldRuleMarkdownEditor Rule="_selectedRule"/>
                </MudTabPanel>

                <MudTabPanel Text="Tags" Icon="@Icons.Material.Filled.Label">
                    <WorldRuleTagsEditor Rules="_rules"/>
                </MudTabPanel>
            </MudTabs>
        }
    }
</MudContainer>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private List<WorldRule>? _rules;
    private WorldRule? _selectedRule;
    private bool _fsSupported;
    private bool _hasAccess;

    protected override async Task OnInitializedAsync() {
        IEnumerable<WorldRule> rules = await WorldRuleRepository.GetRulesAsync();
        _rules = rules.ToList();

        if (!DevFileSystemManager.IsLocalhost) return;

        _fsSupported = await DevFileSystemManager.IsSupportedAsync();

        if (!_fsSupported) return;

        _hasAccess = await DevFileSystemManager.HasAccessAsync();
    }

    private async Task RequestAccess() {
        if (await DevFileSystemManager.RequestAccessAsync()) {
            _hasAccess = true;
            Snackbar.Add("Access granted!", Severity.Success);
        }
        else {
            Snackbar.Add("Failed to get access.", Severity.Error);
        }
    }

    private async Task ResetAccess() {
        await DevFileSystemManager.ResetAccessAsync();
        _hasAccess = false;
        Snackbar.Add("Access reset.", Severity.Info);
    }

    private void OnRuleSelected(WorldRule? rule) {
        _selectedRule = rule;
    }

    private void CreateNewRule() {
        _selectedRule = WorldRuleManager.NewRule();
        _rules?.Insert(0, _selectedRule);
    }

    private async Task DeleteRule() {
        if (_selectedRule is null || _rules is null) return;

        bool confirm = await JsRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this rule?");
        if (!confirm) return;

        WorldRule ruleToDelete = _selectedRule;
        _rules.Remove(ruleToDelete);
        _selectedRule = null;

        if (DevFileSystemManager.IsLocalhost && _hasAccess) {
            bool success = await WorldRuleRepository.DeleteAsync(ruleToDelete, _rules);
            if (success) {
                Snackbar.Add("Rule and markdown files deleted.", Severity.Success);
            }
            else {
                Snackbar.Add("Rule removed from list, but filesystem operation failed or was partial.", Severity.Warning);
            }
        }
        else {
            Snackbar.Add("Read-only mode: Rule removed from list, but files were not deleted.", Severity.Warning);
        }
    }

    private async Task SaveAll() {
        if (_rules is null) return;

        if (!WorldRuleManager.Validate(_rules, out string? errorMessage)) {
            Snackbar.Add(errorMessage!, Severity.Error);
            return;
        }

        bool success = await WorldRuleRepository.SaveAsync(_rules);
        if (success) {
            Snackbar.Add("index.json saved to disk!", Severity.Success);
        }
        else {
            Snackbar.Add("Failed to save index.json.", Severity.Error);
            if (!await DevFileSystemManager.HasAccessAsync()) {
                _hasAccess = false;
            }
        }
    }

    private async Task ExportJson() {
        if (_rules is null) return;

        if (!WorldRuleManager.Validate(_rules, out string? errorMessage)) {
            Snackbar.Add(errorMessage!, Severity.Error);
            return;
        }

        string json = WorldRuleRepository.AsJsonString(_rules);
        await DownloadFile("index.json", json);
    }

    private async Task CopyJson() {
        if (_rules is null) return;
        string json = WorldRuleRepository.AsJsonString(_rules);
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
        Snackbar.Add("JSON copied to clipboard", Severity.Success);
    }

    private async Task GenerateStubs() {
        if (_selectedRule is null) return;

        bool writeToDisk = DevFileSystemManager.IsLocalhost && _hasAccess;
        Dictionary<string, string> stubs = await WorldRuleManager.GenerateStubsAsync(_selectedRule, writeToDisk);

        if (writeToDisk) {
            Snackbar.Add("Markdown stubs saved to disk!", Severity.Success);
            return;
        }

        foreach (KeyValuePair<string, string> stub in stubs) {
            await DownloadFile($"{stub.Key}/{_selectedRule.File}", stub.Value);
        }
    }

    private async Task DownloadFile(string fileName, string content) {
        await JsRuntime.InvokeVoidAsync("downloadFile", fileName, content);
    }
}
