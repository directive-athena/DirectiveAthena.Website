@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Resources
@using DirectiveAthena.Website.Services.Contact
@using Microsoft.Extensions.Localization

@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer
@inject IContactInfoProvider ContactInfoProvider
@inject HttpClient Http
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<footer class="mt-12 py-12">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Justify="Justify.SpaceBetween">
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center mb-4">
                    <MudImage Src="assets/logo.svg" Width="32" Height="32" Alt="Logo" Class="mr-3"/>
                    <MudText Typo="Typo.h6" Class="SpaceGrotesk">@Localizer[Shared.BrandName]</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="text-secondary">
                    @Localizer[Shared.FooterDescription]
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex justify-sm-end align-center">
                @foreach (ContactInfo contactInfo in ContactInfoProvider.GetContactInfos()) {
                    if (!contactInfo.IncludeInFooter) continue;
                    <MudIconButton Icon="@contactInfo.Icon" Href="@contactInfo.Url" Target="_blank" Color="Color.Inherit"/>
                }
            </MudItem>
        </MudGrid>
        <MudDivider Class="my-8 opacity-10"/>
        <MudText Typo="Typo.caption" Class="d-block opacity-60" Align="Align.Center">
            @string.Format(Localizer[Shared.FooterCopyright], DateTime.Now.Year)
        </MudText>
        <MudText Typo="Typo.caption" Class="d-block opacity-50" Align="Align.Center">
            @string.Format(Localizer[Shared.FooterVersion], _version)
        </MudText>
    </MudContainer>
</footer>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    private string _version = "0";

    protected override async Task OnInitializedAsync() {
        try {
            string versionText = await Http.GetStringAsync("version.txt");
            string trimmed = versionText.Trim();
            if (!string.IsNullOrWhiteSpace(trimmed)) {
                _version = trimmed;
            }
        } catch {
            _version = "unknown";
        }
    }
}
