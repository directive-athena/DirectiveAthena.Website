@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<footer class="mt-12 py-12">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Justify="Justify.SpaceBetween">
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center mb-4">
                    <MudImage Src="assets/logo.svg" Width="32" Height="32" Alt="Logo" Class="mr-3"/>
                    <MudText Typo="Typo.h6" Class="SpaceGrotesk">@Localizer[Shared.BrandName]</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="text-secondary">
                    @Localizer[Shared.FooterDescription]
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex justify-sm-end align-center">
                <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Href="https://github.com/directive-athena/Website"
                               Target="_blank" Color="Color.Inherit"/>
                <MudIconButton Icon="@Icons.Custom.Brands.X" Href="https://x.com/AnnaSasDev"
                               Target="_blank" Color="Color.Inherit"/>
                <MudIconButton Icon="@Icons.Material.Filled.VideogameAsset" Href="https://twitch.tv/AnnaSasDev"
                               Target="_blank" Color="Color.Inherit"/>
            </MudItem>
        </MudGrid>
        <MudDivider Class="my-8 opacity-10"/>
        <MudText Typo="Typo.caption" Class="d-block opacity-60" Align="Align.Center">
            @string.Format(Localizer[Shared.FooterCopyright], DateTime.Now.Year)
        </MudText>
    </MudContainer>
</footer>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
