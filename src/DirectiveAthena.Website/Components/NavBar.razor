@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudAppBar Elevation="@(IsScrolled ? 1 : 0)"
           Dense="@IsScrolled"
           Class="@(IsScrolled ? "appbar-glass scrolled" : "appbar-glass")"
           Fixed="true">

    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                   OnClick="@OnMenuClick" Class="mr-2"/>

    @if (IsScrolled) {
        <MudImage Src="assets/logo.svg" Width="32" Height="32" Alt="Logo" Class="mr-3"/>
    }

    <MudButton Variant="Variant.Text" Href="/" Class="@(IsScrolled ? "brand-text d-none d-sm-flex" : "brand-text")">
        @Localizer["Brand.Name"]
    </MudButton>

    <MudSpacer/>

    <CultureSelector/>
</MudAppBar>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public bool IsScrolled { get; set; }
    [Parameter] public EventCallback OnMenuClick { get; set; }
}
