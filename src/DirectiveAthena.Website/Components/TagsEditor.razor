@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using System.Xml.Linq
@using DirectiveAthena.Website.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Tags> Localizer
@inject DevFileSystemService DevFs
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-6 card-glass">
    <MudText Typo="Typo.h5" Class="mb-4">Tags Management</MudText>

    <MudTable Items="@_tagModels" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Class="mb-6">
        <HeaderContent>
            <MudTh>Tag ID</MudTh>
            @foreach (CultureConfig culture in LocalizationConfig.SupportedCultures) {
                <MudTh>@culture.DisplayName (@culture.Code)</MudTh>
            }
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tag ID">
                <MudTextField @bind-Value="context.Id" Label="ID" Required="true"
                              ReadOnly="@context.IsOriginal"/>
            </MudTd>
            @foreach (CultureConfig culture in LocalizationConfig.SupportedCultures) {
                <MudTd DataLabel="@culture.DisplayName">
                    <MudTextField Value="@context.Translations.GetValueOrDefault(culture.Code)"
                                  ValueChanged="@((string? s) => context.Translations[culture.Code] = s ?? throw new ArgumentNullException(s))"
                                  Label="@culture.Abbreviation" Required="true"/>
                </MudTd>
            }
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                               OnClick="@(() => RemoveTag(context))" Disabled="@IsTagInUse(context.Id)"/>
            </MudTd>
        </RowTemplate>
        <FooterContent>
            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@AddNewTag" Color="Color.Primary" Class="ma-2">
                Add Tag
            </MudButton>
        </FooterContent>
    </MudTable>

    <div class="d-flex flex-wrap gap-4">
        @foreach (CultureConfig culture in LocalizationConfig.SupportedCultures) {
            if (DevFs.IsLocalhost) {
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           OnClick="@(() => SaveResxToDisk(culture.Code))" StartIcon="@Icons.Material.Filled.Save">
                    Save Resx (@culture.Code)
                </MudButton>
            }
            else {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           OnClick="@(() => DownloadResx(culture.Code))" StartIcon="@Icons.Material.Filled.Download">
                    Download Resx (@culture.Code)
                </MudButton>
            }
        }
    </div>

    @if (_inUseTags.Any()) {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            Tags currently used in posts: @string.Join(", ", _inUseTags)
        </MudAlert>
    }
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public List<Post> Posts { get; set; } = [];

    private readonly List<TagModel> _tagModels = [];
    private HashSet<string> _inUseTags = [];

    protected override void OnInitialized() {
        LoadTags();
    }

    private void LoadTags() {
        _inUseTags = Posts.SelectMany(p => p.Tags).ToHashSet();

        foreach (string tagId in _inUseTags) {
            AddTagToModel(tagId, true);
        }

        // Also add any other tags found in the default Tags.resx if not already added
        // Since we can't easily iterate all keys in IStringLocalizer for all cultures here,
        // we'll rely on the fact that if it's in use, it's loaded.
        // If we wanted to load ALL tags from resx, we'd need to parse the resx file.

        StateHasChanged();
    }

    private void AddTagToModel(string tagId, bool isOriginal) {
        if (_tagModels.Any(t => t.Id == tagId)) return;

        var model = new TagModel {
            Id = tagId,
            IsOriginal = isOriginal
        };

        foreach (CultureConfig culture in LocalizationConfig.SupportedCultures) {
            // This is a bit tricky since IStringLocalizer doesn't easily let us switch culture per call
            // But we can assume it's already set up or just use the current one as a base
            LocalizedString localized = Localizer.GetString(tagId);
            model.Translations[culture.Code] = localized.ResourceNotFound ? tagId : localized.Value;
        }

        _tagModels.Add(model);
    }

    private async Task AddNewTag() {
        var newTag = new TagModel { Id = "NewTag", IsOriginal = false };
        foreach (CultureConfig culture in LocalizationConfig.SupportedCultures) {
            newTag.Translations[culture.Code] = "";
        }

        _tagModels.Add(newTag);
        await Task.CompletedTask;
    }

    private void RemoveTag(TagModel tag) {
        _tagModels.Remove(tag);
    }

    private bool IsTagInUse(string tagId) => _inUseTags.Contains(tagId);

    private async Task SaveResxToDisk(string locale) {
        if (!DevFs.IsLocalhost) return;

        if (!await DevFs.VerifyPermissionAsync()) {
            Snackbar.Add("Filesystem access required.", Severity.Warning);
            return;
        }

        string path = DevFileSystemService.GetTagsResxPath(locale);
        string existingContent = await DevFs.ReadFileAsync(path) ?? "";
        string newContent = GenerateResx(locale, existingContent);

        bool success = await DevFs.WriteFileAsync(path, newContent);
        if (success) {
            Snackbar.Add($"Saved {path} to disk!", Severity.Success);
        }
        else {
            Snackbar.Add("Failed to save RESX file.", Severity.Error);
        }
    }

    private async Task DownloadResx(string locale) {
        string content = GenerateResx(locale, "");
        string fileName = locale == LocalizationConfig.DefaultCulture.Code ? "Tags.resx" : $"Tags.{locale}.resx";
        await JsRuntime.InvokeVoidAsync("downloadFile", fileName, content);
    }

    private string GenerateResx(string locale, string existingXml) {
        XDocument doc;
        XNamespace xml = "http://www.w3.org/XML/1998/namespace";

        if (!string.IsNullOrWhiteSpace(existingXml)) {
            try {
                doc = XDocument.Parse(existingXml);
            }
            catch {
                doc = CreateNewResx();
            }
        }
        else {
            doc = CreateNewResx();
        }

        XElement? root = doc.Root;
        if (root == null) return doc.ToString();

        foreach (TagModel tag in _tagModels) {
            string key = tag.Id;
            string value = tag.Translations.GetValueOrDefault(locale) ?? "";

            XElement? existingData = root.Elements("data").FirstOrDefault(e => e.Attribute("name")?.Value == key);
            if (existingData is not null) {
                existingData.Element("value")!.Value = value;
            }
            else {
                var data = new XElement("data",
                    new XAttribute("name", key),
                    new XAttribute(xml + "space", "preserve"),
                    new XElement("value", value)
                );
                root.Add(data);
            }
        }

        return doc.ToString();
    }

    private XDocument CreateNewResx() {
        return new XDocument(
            new XElement("root",
                new XElement("resheader", new XAttribute("name", "resmimetype"), new XElement("value", "text/microsoft-resx")),
                new XElement("resheader", new XAttribute("name", "version"), new XElement("value", "2.0")),
                new XElement("resheader", new XAttribute("name", "reader"), new XElement("value", "System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089")),
                new XElement("resheader", new XAttribute("name", "writer"), new XElement("value", "System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"))
            )
        );
    }

    public class TagModel {
        public string Id { get; set; } = "";
        public Dictionary<string, string> Translations { get; set; } = new();
        public bool IsOriginal { get; set; }
    }

}
