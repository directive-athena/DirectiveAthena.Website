@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IArticleManager ArticleManager
@inject IDevFileSystemManager DevFileSystemManager
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

@using DirectiveAthena.Website.Services.FileSystem
@inherits DirectiveAthenaWebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-6 card-glass">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Markdown Editor</MudText>
        <div class="d-flex gap-2">
            <MudSelect T="string" Label="Locale" @bind-Value="_selectedLocale" Class="width-100">
                @foreach (LocalizationInfo culture in LocalizationProvider.GetSupportedLocalizations()) {
                    <MudSelectItem Value="@culture.Code">@culture.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>

    @if (Post is null) {
        <MudAlert Severity="Severity.Info">Select a post to edit its markdown.</MudAlert>
    }
    else {
        <MudText Typo="Typo.subtitle1" Class="mb-2">Editing: <b>@(_selectedLocale)/@Post.File</b></MudText>

        <MudTextField T="string" @bind-Value="_content" Label="Markdown Content"
                      Lines="20" Variant="Variant.Outlined" Class="mb-4"/>

        <div class="d-flex gap-4">
            @if (DevFileSystemManager.IsLocalhost) {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@SaveMarkdown"
                           StartIcon="@Icons.Material.Filled.Save">
                    Save to Disk
                </MudButton>
            }
            else {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@DownloadMarkdown"
                           StartIcon="@Icons.Material.Filled.Download">
                    Download Markdown
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="@CopyToClipboard"
                           StartIcon="@Icons.Material.Filled.ContentCopy">
                    Copy to Clipboard
                </MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@LoadContent"
                       StartIcon="@Icons.Material.Filled.Refresh">
                Reload Original
            </MudButton>
        </div>
    }
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public Article? Post { get; set; }

    private string _selectedLocale = "en";
    private string _content = "";
    private Article? _lastPost;
    private string _lastLocale = "";

    protected override async Task OnParametersSetAsync() {
        if (Post != _lastPost || _selectedLocale != _lastLocale) {
            _lastPost = Post;
            _lastLocale = _selectedLocale;
            await LoadContent();
        }
    }

    private async Task LoadContent() {
        if (Post is null) {
            _content = "";
            return;
        }

        // Try to load from disk first if on localhost and has access
        if (DevFileSystemManager.IsLocalhost && await DevFileSystemManager.HasAccessAsync()) {
            string? diskContent = await DevFileSystemManager.ReadFileAsync(DevFileSystemPaths.GetMarkdownPath(_selectedLocale, Post.File));
            if (diskContent is not null) {
                _content = diskContent;
                return;
            }
        }

        _content = await ArticleManager.GetRawMarkdownContentAsync(Post, _selectedLocale);
        if (string.IsNullOrEmpty(_content)) {
            _content = $"# {Post.Title.GetValueOrDefault(_selectedLocale)}\n\n(New content for {Post.Id} in {_selectedLocale})";
        }
    }

    private async Task SaveMarkdown() {
        if (Post is null || !DevFileSystemManager.IsLocalhost) return;

        if (!await DevFileSystemManager.VerifyPermissionAsync()) {
            Snackbar.Add("Filesystem access required.", Severity.Warning);
            return;
        }

        string path = DevFileSystemPaths.GetMarkdownPath(_selectedLocale, Post.File);
        bool success = await DevFileSystemManager.WriteFileAsync(path, _content);

        if (success) {
            Snackbar.Add($"Saved {_selectedLocale}/{Post.File} to disk!", Severity.Success);
        }
        else {
            Snackbar.Add("Failed to save markdown file.", Severity.Error);
        }
    }

    private async Task DownloadMarkdown() {
        if (Post is null) return;

        string path = $"{_selectedLocale}/{Post.File}";
        await JsRuntime.InvokeVoidAsync("downloadFile", path, _content);
    }

    private async Task CopyToClipboard() {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _content);
    }
}
