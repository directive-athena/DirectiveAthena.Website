@* PostEditor.razor *@

<MudPaper Class="pa-6 card-glass">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h5">Edit Post: @Post.Slug</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                       OnClick="@OnDeletePost"/>
    </div>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Post.Slug" Label="Slug (Unique ID)"
                          Required="true"/>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Post.Date" Label="Date (YYYY-MM-DD)"
                          Required="true"/>
        </MudItem>

        @foreach (CultureConfig culture in LocalizationConfig.SupportedCultures) {
            <MudItem xs="12">
                <MudDivider Class="my-4"/>
                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@culture.DisplayName (@culture.Code)</MudText>
                <MudTextField Value="@GetTitle(culture.Code)"
                              ValueChanged="@((string s) => SetTitle(culture.Code, s))"
                              Label="@($"Title ({culture.Code})")"
                              Required="@(culture.Code == LocalizationConfig.DefaultCulture.Code)"/>
                <MudTextField Value="@GetSummary(culture.Code)"
                              ValueChanged="@((string s) => SetSummary(culture.Code, s))"
                              Label="@($"Summary ({culture.Code})")"
                              Required="@(culture.Code == LocalizationConfig.DefaultCulture.Code)" Lines="3"/>
            </MudItem>
        }

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <MudTextField @bind-Value="Post.File" Label="Markdown Filename (e.g. post.md)" Required="true"/>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.subtitle1" Color="Color.Primary">Tags</MudText>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (string tag in Post.Tags) {
                    <MudChip T="string" OnClose="@(() => RemoveTag(tag))" Color="Color.Secondary"
                             Variant="Variant.Filled">@tag</MudChip>
                }
            </div>
            <div class="d-flex gap-2">
                <MudTextField @bind-Value="_newTag" Label="Add Tag ID" @onkeydown="@OnTagKey"/>
                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="@AddTag"/>
            </div>
            <MudText Typo="Typo.caption" Class="mt-1 d-block">
                Ensure Tag ID exists in the Tags tab.
            </MudText>
        </MudItem>

        <MudItem xs="12" Class="mt-4">
            @if (DevFs.IsLocalhost) {
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@OnGenerateStubs"
                           StartIcon="@Icons.Material.Filled.NoteAdd">
                    Save Markdown Stubs to Disk
                </MudButton>
            }
            else {
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@OnGenerateStubs"
                           StartIcon="@Icons.Material.Filled.Download">
                    Download Markdown Stubs
                </MudButton>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter, EditorRequired] public Post Post { get; set; } = null!;
    [Parameter] public EventCallback OnDeletePost { get; set; }
    [Parameter] public EventCallback OnGenerateStubs { get; set; }

    [Inject] private DevFileSystemService DevFs { get; set; } = null!;

    private string _newTag = "";

    private string GetTitle(string culture) => Post.Title.GetValueOrDefault(culture) ?? "";
    private void SetTitle(string culture, string value) => Post.Title[culture] = value;

    private string GetSummary(string culture) => Post.Summary.GetValueOrDefault(culture) ?? "";
    private void SetSummary(string culture, string value) => Post.Summary[culture] = value;

    private void AddTag() {
        if (string.IsNullOrWhiteSpace(_newTag) || Post.Tags.Contains(_newTag)) return;
        Post.Tags.Add(_newTag.Trim());
        _newTag = "";
    }

    private void RemoveTag(string tag) {
        Post.Tags.Remove(tag);
    }

    private void OnTagKey(KeyboardEventArgs e) {
        if (e.Key == "Enter") AddTag();
    }

}
