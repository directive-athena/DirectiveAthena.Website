@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Services.FileSystem
@using DirectiveAthena.Website.Services.Localization

@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IDevFileSystemManager DevFileSystemManager
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-6 card-glass">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">@Title</MudText>
        <div class="d-flex gap-2">
            <MudSelect T="string" Label="Locale" @bind-Value="_selectedLocale" Class="width-100">
                @foreach (LocalizationInfo culture in LocalizationProvider.GetSupportedLocalizations()) {
                    <MudSelectItem Value="@culture.Code">@culture.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>

    @if (string.IsNullOrWhiteSpace(FileName) || LoadContentAsync is null || GetDiskPath is null || BuildDefaultContent is null) {
        <MudAlert Severity="Severity.Info">Select an item to edit its markdown.</MudAlert>
    }
    else {
        <MudText Typo="Typo.subtitle1" Class="mb-2">Editing: <b>@(_selectedLocale)/@FileName</b></MudText>

        <MudTextField T="string" @bind-Value="_content" Label="Markdown Content"
                      Lines="16" Variant="Variant.Outlined" Class="mb-4"/>

        <div class="d-flex gap-4">
            @if (DevFileSystemManager.IsLocalhost) {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@SaveMarkdown"
                           StartIcon="@Icons.Material.Filled.Save">
                    Save to Disk
                </MudButton>
            }
            else {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@DownloadMarkdown"
                           StartIcon="@Icons.Material.Filled.Download">
                    Download Markdown
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="@CopyToClipboard"
                           StartIcon="@Icons.Material.Filled.ContentCopy">
                    Copy to Clipboard
                </MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@LoadContent"
                       StartIcon="@Icons.Material.Filled.Refresh">
                Reload Original
            </MudButton>
        </div>
    }
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public string Title { get; set; } = "Markdown Editor";
    [Parameter] public string? FileName { get; set; }
    [Parameter] public Func<string, Task<string>>? LoadContentAsync { get; set; }
    [Parameter] public Func<string, string>? BuildDefaultContent { get; set; }
    [Parameter] public Func<string, string>? GetDiskPath { get; set; }

    private string _selectedLocale = "en";
    private string _content = "";
    private string? _lastFile;
    private string _lastLocale = "";

    protected override async Task OnParametersSetAsync() {
        if (_lastFile != FileName || _selectedLocale != _lastLocale) {
            _lastFile = FileName;
            _lastLocale = _selectedLocale;
            await LoadContent();
        }
    }

    private async Task LoadContent() {
        if (string.IsNullOrWhiteSpace(FileName) || LoadContentAsync is null || GetDiskPath is null || BuildDefaultContent is null) {
            _content = "";
            return;
        }

        if (DevFileSystemManager.IsLocalhost && await DevFileSystemManager.HasAccessAsync()) {
            string? diskContent = await DevFileSystemManager.ReadFileAsync(GetDiskPath(_selectedLocale));
            if (diskContent is not null) {
                _content = diskContent;
                return;
            }
        }

        _content = await LoadContentAsync(_selectedLocale);
        if (string.IsNullOrEmpty(_content)) {
            _content = BuildDefaultContent(_selectedLocale);
        }
    }

    private async Task SaveMarkdown() {
        if (string.IsNullOrWhiteSpace(FileName) || GetDiskPath is null || !DevFileSystemManager.IsLocalhost) return;

        if (!await DevFileSystemManager.VerifyPermissionAsync()) {
            Snackbar.Add("Filesystem access required.", Severity.Warning);
            return;
        }

        bool success = await DevFileSystemManager.WriteFileAsync(GetDiskPath(_selectedLocale), _content);
        if (success) {
            Snackbar.Add($"Saved {_selectedLocale}/{FileName} to disk!", Severity.Success);
        }
        else {
            Snackbar.Add("Failed to save markdown file.", Severity.Error);
        }
    }

    private async Task DownloadMarkdown() {
        if (string.IsNullOrWhiteSpace(FileName)) return;
        string path = $"{_selectedLocale}/{FileName}";
        await JsRuntime.InvokeVoidAsync("downloadFile", path, _content);
    }

    private async Task CopyToClipboard() {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _content);
    }
}
