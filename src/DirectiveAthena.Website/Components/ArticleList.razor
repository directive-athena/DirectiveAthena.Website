@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-4 card-glass mb-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">Posts</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@OnCreatePost"/>
    </div>
    <MudList T="Article" SelectedValue="SelectedPost" SelectedValueChanged="OnPostSelected"
             Color="Color.Primary">
        @if (Posts is not null) {
            foreach (Article post in Posts) {
                <MudListItem Value="post">
                    <div class="d-flex flex-column">
                        <MudText
                            Typo="Typo.body1">@(post.Title.GetValueOrDefault("en") ?? "Untitled")</MudText>
                        <MudText Typo="Typo.caption" Class="opacity-50">@post.Id</MudText>
                        <div class="d-flex align-center gap-1">
                            @if (post.Hidden) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Icon="@Icons.Material.Filled.VisibilityOff">Hidden</MudChip>
                            }
                            @if (string.IsNullOrEmpty(post.Title.GetValueOrDefault("nl")) || string.IsNullOrEmpty(post.Summary.GetValueOrDefault("nl"))) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                         Variant="Variant.Text">Missing NL
                                </MudChip>
                            }
                        </div>
                    </div>
                </MudListItem>
            }
        }
    </MudList>
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public List<Article>? Posts { get; set; }
    [Parameter] public Article? SelectedPost { get; set; }
    [Parameter] public EventCallback<Article?> OnPostSelected { get; set; }
    [Parameter] public EventCallback OnCreatePost { get; set; }
}
