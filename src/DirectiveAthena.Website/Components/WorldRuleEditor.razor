@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Services.FileSystem
@using DirectiveAthena.Website.Services.Localization
@using DirectiveAthena.Website.Services.WorldRules

@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IDevFileSystemManager DevFileSystemManager
@inject IWorldRuleManager WorldRuleManager
@inject IDevFileSystemPaths DevFilePaths

@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-6 card-glass">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h5">Edit Rule: @Rule.Id</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                       OnClick="@OnDeleteRule"/>
    </div>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField Value="@Rule.Id" Label="Unique ID"
                          Required="true" ReadOnly="true"
                          HelperText="GUID is generated automatically for new rules."/>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Rule.Date" Label="Date (YYYY-MM-DD)"
                          Required="true"/>
        </MudItem>

        @foreach (LocalizationInfo culture in LocalizationProvider.GetSupportedLocalizations()) {
            <MudItem xs="12">
                <MudDivider Class="my-4"/>
                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@culture.DisplayName (@culture.Code)</MudText>
                <MudTextField Value="@GetQuestion(culture.Code)"
                              ValueChanged="@((string s) => SetQuestion(culture.Code, s))"
                              Label="@($"Question ({culture.Code})")"
                              Required="@(LocalizationProvider.IsDefaultCultureCode(culture.Code))"/>
                <MudTextField Value="@GetAnswer(culture.Code)"
                              ValueChanged="@((string s) => SetAnswer(culture.Code, s))"
                              Label="@($"Answer ({culture.Code})")"
                              Required="@(LocalizationProvider.IsDefaultCultureCode(culture.Code))" Lines="3"/>
            </MudItem>
        }

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <MudTextField Value="@Rule.File" Label="Markdown Filename (e.g. rule.md)" Required="true" ReadOnly="true"
                          HelperText="Filename matches GUID and cannot be changed."/>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.subtitle1" Color="Color.Primary">Tags</MudText>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (string tag in Rule.Tags) {
                    <MudChip T="string" OnClose="@(() => RemoveTag(tag))" Color="Color.Secondary"
                             Variant="Variant.Filled">@tag</MudChip>
                }
            </div>
            <div class="d-flex gap-2">
                <MudTextField @bind-Value="_newTag" Label="Add Tag ID" OnKeyDown="@OnTagKey"/>
                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="@AddTag"/>
            </div>
            <MudText Typo="Typo.caption" Class="mt-1 d-block">
                Ensure Tag ID exists in the Tags tab.
            </MudText>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <LocalizedMarkdownEditor Title="Markdown"
                                     FileName="@Rule.File"
                                     LoadContentAsync="@((string locale) => WorldRuleManager.GetRawMarkdownContentAsync(Rule, locale))"
                                     BuildDefaultContent="@((string locale) => BuildDefaultMarkdown(locale))"
                                     GetDiskPath="@((string locale) => DevFilePaths.GetWorldRuleMarkdownPath(locale, Rule.File))"/>
        </MudItem>

        <MudItem xs="12" Class="mt-4">
            @if (DevFileSystemManager.IsLocalhost) {
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@OnGenerateStubs"
                           StartIcon="@Icons.Material.Filled.NoteAdd">
                    Save Markdown Stubs to Disk
                </MudButton>
            }
            else {
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@OnGenerateStubs"
                           StartIcon="@Icons.Material.Filled.Download">
                    Download Markdown Stubs
                </MudButton>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter, EditorRequired] public WorldRule Rule { get; set; } = null!;
    [Parameter] public EventCallback OnDeleteRule { get; set; }
    [Parameter] public EventCallback OnGenerateStubs { get; set; }

    private string _newTag = "";

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    private string GetQuestion(string culture)
        => Rule.Question.GetValueOrDefault(culture) ?? "";
    private void SetQuestion(string culture, string value)
        => Rule.Question[culture] = value;

    private string GetAnswer(string culture)
        => Rule.Answer.GetValueOrDefault(culture) ?? "";
    private void SetAnswer(string culture, string value)
        => Rule.Answer[culture] = value;

    private void AddTag() {
        if (string.IsNullOrWhiteSpace(_newTag)) return;

        string trimmedTag = _newTag.Trim();
        if (Rule.Tags.Contains(trimmedTag)) {
            _newTag = "";
            return;
        }

        Rule.Tags.Add(trimmedTag);
        _newTag = "";
    }

    private void RemoveTag(string tag)
        => Rule.Tags.Remove(tag);

    private void OnTagKey(KeyboardEventArgs e) {
        if (e.Key == "Enter") AddTag();
    }

    private string BuildDefaultMarkdown(string locale) {
        string question = Rule.Question.GetValueOrDefault(locale) ?? "New Rule";
        string answer = Rule.Answer.GetValueOrDefault(locale) ?? "";
        return $"# {question}\n\n{answer}";
    }
}
