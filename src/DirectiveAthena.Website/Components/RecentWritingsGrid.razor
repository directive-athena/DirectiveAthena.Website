@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject WritingsService WritingsService
@inject NavigationManager Nav
@inject IStringLocalizer<Shared> Localizer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
@if (_posts != null && _posts.Any()) {
    foreach (Post post in _posts) {
        <MudItem xs="12" md="4">
            <MudCard Class="card-glass h-100 d-flex flex-column"
                     @onclick="@(() => ViewPost(post.Slug))"
                     Style="cursor: pointer;">
                <MudCardContent Class="flex-grow-1 pa-6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                             Class="mb-2 d-block">@post.Date</MudText>
                    <MudText Typo="Typo.h5"
                             Class="mb-4 SpaceGrotesk">@WritingsService.GetLocalizedTitle(post)</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary opacity-70 mb-4"
                             Style="line-height: 1.5;">
                        @WritingsService.GetLocalizedSummary(post)
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary"
                               Class="pa-0">@Localizer["Home.Writings.ReadMore"]</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
}

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private IEnumerable<Post>? _posts;

    protected override async Task OnInitializedAsync() {
        Post[] posts = await WritingsService.GetPostsAsync();
        _posts = posts.Skip(1).Take(3);
    }

    private void ViewPost(string slug) {
        Nav.NavigateTo($"/writings/{slug}");
    }
}
