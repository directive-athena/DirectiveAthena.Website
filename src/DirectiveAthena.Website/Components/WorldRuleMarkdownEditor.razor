@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Services.FileSystem
@using DirectiveAthena.Website.Services.Localization
@using DirectiveAthena.Website.Services.WorldRules

@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IWorldRuleManager WorldRuleManager
@inject IDevFileSystemManager DevFileSystemManager
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject IDevFileSystemPaths DevFilePaths

@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-6 card-glass">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Markdown Editor</MudText>
        <div class="d-flex gap-2">
            <MudSelect T="string" Label="Locale" @bind-Value="_selectedLocale" Class="width-100">
                @foreach (LocalizationInfo culture in LocalizationProvider.GetSupportedLocalizations()) {
                    <MudSelectItem Value="@culture.Code">@culture.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>

    @if (Rule is null) {
        <MudAlert Severity="Severity.Info">Select a rule to edit its markdown.</MudAlert>
    }
    else {
        <MudText Typo="Typo.subtitle1" Class="mb-2">Editing: <b>@(_selectedLocale)/@Rule.File</b></MudText>

        <MudTextField T="string" @bind-Value="_content" Label="Markdown Content"
                      Lines="20" Variant="Variant.Outlined" Class="mb-4"/>

        <div class="d-flex gap-4">
            @if (DevFileSystemManager.IsLocalhost) {
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@SaveMarkdown"
                           StartIcon="@Icons.Material.Filled.Save">
                    Save to Disk
                </MudButton>
            }
            else {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@DownloadMarkdown"
                           StartIcon="@Icons.Material.Filled.Download">
                    Download Markdown
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="@CopyToClipboard"
                           StartIcon="@Icons.Material.Filled.ContentCopy">
                    Copy to Clipboard
                </MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@LoadContent"
                       StartIcon="@Icons.Material.Filled.Refresh">
                Reload Original
            </MudButton>
        </div>
    }
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public WorldRule? Rule { get; set; }

    private string _selectedLocale = "en";
    private string _content = "";
    private WorldRule? _lastRule;
    private string _lastLocale = "";

    protected override async Task OnParametersSetAsync() {
        if (Rule != _lastRule || _selectedLocale != _lastLocale) {
            _lastRule = Rule;
            _lastLocale = _selectedLocale;
            await LoadContent();
        }
    }

    private async Task LoadContent() {
        if (Rule is null) {
            _content = "";
            return;
        }

        if (DevFileSystemManager.IsLocalhost && await DevFileSystemManager.HasAccessAsync()) {
            string? diskContent = await DevFileSystemManager.ReadFileAsync(
                DevFilePaths.GetWorldRuleMarkdownPath(_selectedLocale, Rule.File));
            if (diskContent is not null) {
                _content = diskContent;
                return;
            }
        }

        _content = await WorldRuleManager.GetRawMarkdownContentAsync(Rule, _selectedLocale);
        if (string.IsNullOrEmpty(_content)) {
            string question = Rule.Question.GetValueOrDefault(_selectedLocale) ?? "New Rule";
            string answer = Rule.Answer.GetValueOrDefault(_selectedLocale) ?? "";
            _content = $"# {question}\n\n{answer}";
        }
    }

    private async Task SaveMarkdown() {
        if (Rule is null || !DevFileSystemManager.IsLocalhost) return;

        if (!await DevFileSystemManager.VerifyPermissionAsync()) {
            Snackbar.Add("Filesystem access required.", Severity.Warning);
            return;
        }

        string path = DevFilePaths.GetWorldRuleMarkdownPath(_selectedLocale, Rule.File);
        bool success = await DevFileSystemManager.WriteFileAsync(path, _content);

        if (success) {
            Snackbar.Add($"Saved {_selectedLocale}/{Rule.File} to disk!", Severity.Success);
        }
        else {
            Snackbar.Add("Failed to save markdown file.", Severity.Error);
        }
    }

    private async Task DownloadMarkdown() {
        if (Rule is null) return;

        string path = $"{_selectedLocale}/{Rule.File}";
        await JsRuntime.InvokeVoidAsync("downloadFile", path, _content);
    }

    private async Task CopyToClipboard() {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _content);
    }
}
