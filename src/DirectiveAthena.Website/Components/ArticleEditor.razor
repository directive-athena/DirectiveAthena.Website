@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthena.Website.Resources
@using DirectiveAthena.Website.Services.Articles
@using DirectiveAthena.Website.Services.FileSystem
@using DirectiveAthena.Website.Services.Localization
@using Microsoft.Extensions.Localization

@namespace DirectiveAthena.Website.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IArticleManager ArticleManager
@inject IContentStorageFactory ContentStorageFactory
@inject IStringLocalizer<Shared> Localizer

@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-6 card-glass no-hover">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h5">@string.Format(Localizer[Shared.EditorEditPost], Post.Id.ToString("D"))</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                       OnClick="@OnDeletePost"/>
    </div>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField Value="@Post.Id.ToString("D")" Label="@Localizer[Shared.EditorUniqueId]"
                          Required="true" ReadOnly="true"
                          HelperText="@Localizer[Shared.EditorIdHelperPost]"/>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Post.Date" Label="@Localizer[Shared.EditorDateLabel]"
                          Required="true"/>
        </MudItem>

        <MudItem xs="12">
            <MudSwitch @bind-Value="Post.Hidden" Label="@Localizer[Shared.EditorHiddenLabel]" Color="Color.Primary"/>
        </MudItem>

        @foreach (LocalizationInfo culture in LocalizationProvider.GetSupportedLocalizations()) {
            <MudItem xs="12">
                <MudDivider Class="my-4"/>
                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@culture.DisplayName (@culture.Code)</MudText>
                <MudTextField Value="@GetTitle(culture.Code)"
                              ValueChanged="@((string s) => SetTitle(culture.Code, s))"
                              Label="@($"{Localizer[Shared.EditorTitleLabel]} ({culture.Code})")"
                              Required="@(LocalizationProvider.IsDefaultCultureCode(culture.Code))"/>
                <MudTextField Value="@GetSummary(culture.Code)"
                              ValueChanged="@((string s) => SetSummary(culture.Code, s))"
                              Label="@($"{Localizer[Shared.EditorSummaryLabel]} ({culture.Code})")"
                              Required="@(LocalizationProvider.IsDefaultCultureCode(culture.Code))" Lines="3"/>
            </MudItem>
        }

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <MudTextField Value="@Post.MarkdownFileName"
                          Label="@string.Format(Localizer[Shared.EditorMarkdownFileLabel], "post.md")"
                          Required="true" ReadOnly="true"
                          HelperText="@Localizer[Shared.EditorMarkdownFileHelper]"/>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <MudText Typo="Typo.subtitle1" Color="Color.Primary">@Localizer[Shared.EditorTagsTitle]</MudText>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (string tag in Post.Tags) {
                    <MudChip T="string" OnClose="@(() => RemoveTag(tag))" Color="Color.Secondary"
                             Variant="Variant.Filled">@tag</MudChip>
                }
            </div>
            <div class="d-flex gap-2">
                <MudTextField @bind-Value="_newTag" Label="@Localizer[Shared.EditorAddTag]" @Onkeydown="@OnTagKey"/>
                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="@AddTag"/>
            </div>
            <MudText Typo="Typo.caption" Class="mt-1 d-block">
                @Localizer[Shared.EditorTagsHint]
            </MudText>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <LocalizedMarkdownEditor Title="@Localizer[Shared.MarkdownLabel]"
                                     FileName="@Post.MarkdownFileName"
                                     LoadContentAsync="@((string locale) => ArticleManager.GetRawMarkdownContentAsync(Post, locale))"
                                     BuildDefaultContent="@((string locale) => BuildDefaultMarkdown(locale))"
                                     GetDiskPath="@((string locale) => _storage.GetMarkdownDiskPath(locale, Post.MarkdownFileName))"/>
        </MudItem>

        <MudItem xs="12" Class="mt-4">
            @if (_storage.IsLocalhost) {
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@OnGenerateStubs"
                           StartIcon="@Icons.Material.Filled.NoteAdd">
                    @Localizer[Shared.ContentManagerMarkdownStubsSaveDisk]
                </MudButton>
            }
            else {
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@OnGenerateStubs"
                           StartIcon="@Icons.Material.Filled.Download">
                    @Localizer[Shared.ContentManagerMarkdownStubsDownload]
                </MudButton>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter, EditorRequired] public Article Post { get; set; } = null!;
    [Parameter] public EventCallback OnDeletePost { get; set; }
    [Parameter] public EventCallback OnGenerateStubs { get; set; }
    [Parameter] public EventCallback OnTagsChanged { get; set; }

    private string _newTag = "";
    private IContentStorage _storage = null!;

    protected override void OnInitialized() {
        _storage = ContentStorageFactory.ForCategory(ContentCategory.Articles);
    }

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    private string GetTitle(string culture)
        => Post.Title.GetValueOrDefault(culture) ?? "";
    private void SetTitle(string culture, string value)
        => Post.Title[culture] = value;

    private string GetSummary(string culture)
        => Post.Summary.GetValueOrDefault(culture) ?? "";
    private void SetSummary(string culture, string value)
        => Post.Summary[culture] = value;

    private void AddTag() {
        if (string.IsNullOrWhiteSpace(_newTag)) return;

        string trimmedTag = _newTag.Trim();
        if (Post.Tags.Contains(trimmedTag)) {
            _newTag = "";
            return;
        }

        Post.Tags.Add(trimmedTag);
        _newTag = "";
        NotifyTagsChanged();
    }

    private void RemoveTag(string tag) {
        Post.Tags.Remove(tag);
        NotifyTagsChanged();
    }

    private void OnTagKey(KeyboardEventArgs e) {
        if (e.Key == "Enter") AddTag();
    }

    private void NotifyTagsChanged() {
        if (OnTagsChanged.HasDelegate) {
            _ = OnTagsChanged.InvokeAsync();
        }
    }

    private string BuildDefaultMarkdown(string locale) {
        string title = Post.Title.GetValueOrDefault(locale) ?? Localizer[Shared.EditorNewPostTitle];
        string summary = Post.Summary.GetValueOrDefault(locale) ?? "";
        return $"# {title}\n\n{summary}";
    }

}
