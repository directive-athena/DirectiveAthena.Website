@using DirectiveAthena.Website.Components
@inherits LayoutComponentBase
@implements IDisposable

<MudLayout Class="min-vh-100 d-flex flex-column">
    <BackgroundLayer />

    <NavBar IsScrolled="_isScrolled" OnMenuClick="@(_ => _drawerOpen = !_drawerOpen)" />

    <DrawerMenu @bind-Open="_drawerOpen" />

    <MudMainContent Class="relative flex-grow-1 d-flex flex-column">
        <div class="flex-grow-1">
            @Body
        </div>
        
        <Footer />
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen;
    bool _isScrolled;

    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

    private DotNetObjectReference<MainLayout>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            _objRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("registerScrollListener", _objRef);
        }
    }

    [JSInvokable]
    public void OnScroll(double scrollY) {
        bool scrolled = scrollY > 50;
        
        if (scrolled == _isScrolled) return;
        
        _isScrolled = scrolled;
        StateHasChanged();
    }

    public void Dispose() {
        _objRef?.Dispose();
    }

}