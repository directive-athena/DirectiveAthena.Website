@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniBlazor.Markdown.Parsers.Blazor
@using InfiniBlazor.Markdown.Syntax.Nodes

@namespace DirectiveAthenaWeb.Services.Markdown
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inherits InfiniBlazorMdComponentBase<CalloutMdSyntaxNode>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudAlert Severity="@GetSeverity()" Variant="Variant.Outlined" Class="my-4">
    <MudText Typo="Typo.subtitle2" Class="fw-bold">
        @if (SyntaxNode.TryGetTitleNode(out CalloutTitleMdSyntaxNode? titleNode)) {
            @ComponentConverter.RenderChildComponents(titleNode)
        } else {
            @SyntaxNode.CalloutType
        }
    </MudText>
    @if (SyntaxNode.TryGetBodyNode(out CalloutBodyMdSyntaxNode? bodyNode)) {
        @ComponentConverter.RenderChildComponents(bodyNode)
    }
</MudAlert>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private Severity GetSeverity() => SyntaxNode.CalloutType?.ToLower() switch {
        "info" => Severity.Info,
        "success" => Severity.Success,
        "warning" => Severity.Warning,
        "error" or "danger" => Severity.Error,
        "note" => Severity.Info,
        "tip" => Severity.Success,
        "important" => Severity.Warning,
        "caution" => Severity.Error,
        _ => Severity.Normal
    };
}