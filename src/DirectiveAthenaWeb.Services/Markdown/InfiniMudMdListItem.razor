@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniBlazor.Markdown.Parsers.Blazor
@using InfiniBlazor.Markdown.Syntax.Nodes

@namespace DirectiveAthenaWeb.Services.Markdown
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inherits InfiniBlazorMdComponentBase<ListItemMdSyntaxNode>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudListItem T="ListItemMdSyntaxNode" Dense="true">
    <ChildContent>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            @if (SyntaxNode.IsCheckable) {
                <MudCheckBox T="bool" Value="@SyntaxNode.IsChecked" ValueChanged="@OnCheckChanged" Dense="true"
                             Color="Color.Primary"/>
            }
            <MudText Typo="Typo.body1" UserAttributes="@GetAttributes()">
                @ComponentConverter.RenderChildComponents(SyntaxNode)
            </MudText>
        </MudStack>
    </ChildContent>
</MudListItem>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private Dictionary<string, object> GetAttributes() {
        var attrs = new Dictionary<string, object>();
        string style = SyntaxNode.IsInapplicable ? "text-decoration: line-through; opacity: 0.6;" : "";
        if (!string.IsNullOrEmpty(style)) attrs["style"] = style;
        return attrs;
    }

    private async Task OnCheckChanged(bool state) {
        SyntaxNode.WithCheckMarker(state ? "x" : " ");
        if (RenderContext is not null) await RenderContext.InvokeSyntaxNodeChange(SyntaxNode);
    }
}