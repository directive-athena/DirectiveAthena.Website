@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Content.Story
@using Microsoft.Extensions.Localization
@using DirectiveAthenaWeb.Client.Resources
@using DirectiveAthenaWeb.Content.Resources

@namespace DirectiveAthenaWeb.Client.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/story"

@inject IStoryContentRepository StoryRepository
@inject IStoryContentManager StoryManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Client> LocalizerShared
@inject IStringLocalizer<Tags> LocalizerTags

@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@LocalizerShared[Client.StoryTitle]</PageTitle>

<div class="min-vh-100 py-32">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="text-center mb-16">
            <MudText Typo="Typo.h2" Class="mb-4">@LocalizerShared[Client.StoryHeading]</MudText>
            <MudText Typo="Typo.body1" Class="text-secondary opacity-70">@LocalizerShared[Client.StorySubtitle]
            </MudText>
        </div>

        <div class="d-flex flex-wrap justify-center gap-2 mb-12">
            <MudChip T="string" Variant="@(string.IsNullOrEmpty(_selectedTag) ? Variant.Filled : Variant.Outlined)"
                     Color="Color.Secondary" OnClick="@ClearTag">@LocalizerShared[Client.StoryAll]
            </MudChip>
            @if (_stories is not null) {
                foreach (string tag in _stories.SelectMany(p => p.Tags).Distinct()) {
                    <MudChip T="string" Variant="@(_selectedTag == tag ? Variant.Filled : Variant.Outlined)"
                             Color="Color.Secondary"
                             OnClick="@(() => FilterByTag(tag))">@LocalizerTags[tag]</MudChip>
                }
            }
        </div>

        @if (_stories is null) {
            <div class="d-flex justify-center py-12">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large"/>
            </div>
        }
        else if (!FilteredStories.Any()) {
            <MudCard Class="card-glass pa-8 text-center border-dashed">
                <MudText Typo="Typo.h6" Class="opacity-70">@LocalizerShared[Client.StoryEmpty]</MudText>
            </MudCard>
        }
        else {
            <MudGrid Spacing="6">
                @foreach (StoryContent story in FilteredStories) {
                    <MudItem xs="12" md="6">
                        <MudCard Class="card-glass h-100 d-flex flex-column" @onclick="@(() => ViewStory(story.Id))"
                                 Style="cursor: pointer;">
                            <MudCardContent Class="flex-grow-1 pa-8">
                                <div class="d-flex justify-space-between align-center mb-4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                             Style="letter-spacing: 0.1em; text-transform: uppercase;">@FormatDate(story.CreatedAt)</MudText>
                                    <div class="d-flex gap-1">
                                        @foreach (string tag in story.Tags.Take(2)) {
                                            <span class="px-2 py-0 rounded"
                                                  style="background: rgba(0, 229, 255, 0.1); color: var(--neon-cyan); font-size: 0.7rem; border: 1px solid rgba(0, 229, 255, 0.2);">@LocalizerTags[tag]</span>
                                        }
                                    </div>
                                </div>
                                <MudText Typo="Typo.h4"
                                         Class="mb-4 SpaceGrotesk">@StoryManager.GetLocalizedTitle(story)</MudText>
                                <MudText Typo="Typo.body2" Class="text-secondary mb-4"
                                         Style="line-height: 1.6;">
                                    @StoryManager.GetLocalizedSummary(story)
                                </MudText>
                                @if (story.Chapters.Count > 0) {
                                    <MudText Typo="Typo.caption" Class="opacity-60 mb-4">
                                        @LocalizerShared[Client.StoryChapters, story.Chapters.Count]
                                    </MudText>
                                }
                                <MudButton Variant="Variant.Text" Color="Color.Secondary"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           Class="pa-0">@LocalizerShared[Client.StoryRead]
                                </MudButton>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudContainer>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private StoryContent[]? _stories;
    private string? _selectedTag;

    protected override async Task OnInitializedAsync() {
        IEnumerable<StoryContent> stories = await StoryRepository.GetAllAsync();
        _stories = stories.ToArray();
    }

    private IEnumerable<StoryContent> FilteredStories =>
        string.IsNullOrEmpty(_selectedTag)
            ? _stories ?? []
            : (_stories ?? []).Where(p => p.Tags.Contains(_selectedTag));

    private void FilterByTag(string tag) => _selectedTag = tag;
    private void ClearTag() => _selectedTag = null;

    private void ViewStory(Guid id) {
        NavigationManager.NavigateTo($"/story/{id:D}");
    }
}
