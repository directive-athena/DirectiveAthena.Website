@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Localization
@using DirectiveAthenaWeb.Services.Localization.Resources
@using DirectiveAthenaWeb.Services.WorldFaq
@using InfiniBlazor.Markdown
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Client.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/world-faq"
@page "/faq"

@inject IWorldFaqRepository WorldFaqRepository
@inject IWorldFaqManager WorldFaqManager
@inject ILocalizationProvider LocalizationProvider
@inject IStringLocalizer<Shared> LocalizerShared
@inject IStringLocalizer<Tags> LocalizerTags
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@LocalizerShared[Shared.WorldFaqTitle]</PageTitle>

<div class="min-vh-100 py-32">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="text-center mb-16">
            <MudText Typo="Typo.h2" Class="mb-4">@LocalizerShared[Shared.WorldFaqHeading]</MudText>
            <MudText Typo="Typo.body1" Class="text-secondary opacity-70">@LocalizerShared[Shared.WorldFaqSubtitle]
            </MudText>
        </div>

        <div class="d-flex flex-wrap justify-center gap-2 mb-12">
            <MudChip T="string" Variant="@(string.IsNullOrEmpty(_selectedTag) ? Variant.Filled : Variant.Outlined)"
                     Color="Color.Secondary" OnClick="@ClearTag">@LocalizerShared[Shared.WorldFaqAll]
            </MudChip>
            @if (_rules is not null) {
                foreach (string tag in _rules.SelectMany(r => r.Tags).Distinct()) {
                    <MudChip T="string" Variant="@(_selectedTag == tag ? Variant.Filled : Variant.Outlined)"
                             Color="Color.Secondary"
                             OnClick="@(() => FilterByTag(tag))">@LocalizerTags[tag]</MudChip>
                }
            }
        </div>

        @if (_rules is null) {
            <div class="d-flex justify-center py-12">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large"/>
            </div>
        }
        else if (!FilteredRules.Any()) {
            <MudCard Class="card-glass pa-8 text-center border-dashed">
                <MudText Typo="Typo.h6" Class="opacity-70">@LocalizerShared[Shared.WorldFaqEmpty]</MudText>
            </MudCard>
        }
        else {
            <MudExpansionPanels MultiExpansion="true">
                @foreach (WorldFaqView rule in FilteredRules) {
                    <MudExpansionPanel Class="card-glass mb-4">
                        <TitleContent>
                            <div class="d-flex flex-column gap-2">
                                @if (!string.IsNullOrWhiteSpace(rule.Date)) {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                             Style="letter-spacing: 0.15em; text-transform: uppercase;">
                                        @string.Format(LocalizerShared[Shared.WorldFaqUpdated], rule.Date)
                                    </MudText>
                                }
                                <MudText Typo="Typo.h5" Class="SpaceGrotesk">@rule.Title</MudText>
                                @if (rule.Tags.Count > 0) {
                                    <div class="d-flex gap-1">
                                        @foreach (string tag in rule.Tags.Take(3)) {
                                            <span class="px-2 py-0 rounded"
                                                  style="background: rgba(0, 229, 255, 0.1); color: var(--neon-cyan); font-size: 0.7rem; border: 1px solid rgba(0, 229, 255, 0.2);">@LocalizerTags[tag]</span>
                                        }
                                    </div>
                                }
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudText Typo="Typo.body1" Class="text-secondary mb-6" Style="line-height: 1.7;">
                                @rule.Summary
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(rule.Content)) {
                                <div class="markdown-content">
                                    <InfiniMarkdownPreview Content="@rule.Content"/>
                                </div>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudContainer>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private List<WorldFaqView>? _rules;
    private string? _selectedTag;

    protected override async Task OnInitializedAsync() {
        IEnumerable<WorldFaq> rules = await WorldFaqRepository.GetAllAsync();
        List<WorldFaqView> viewRules = new();
        string locale = LocalizationProvider.GetCurrentLocalization().Code;

        foreach (WorldFaq rule in rules) {
            string content = await WorldFaqManager.GetRawMarkdownContentAsync(rule, locale);
            viewRules.Add(new WorldFaqView(
                rule,
                WorldFaqManager.GetLocalizedQuestion(rule),
                WorldFaqManager.GetLocalizedAnswer(rule),
                content));
        }

        _rules = viewRules;
    }

    private IEnumerable<WorldFaqView> OrderedRules =>
        (_rules ?? [])
        .OrderByDescending(rule => rule.SortDate)
        .ThenBy(rule => rule.Title);

    private IEnumerable<WorldFaqView> FilteredRules =>
        string.IsNullOrEmpty(_selectedTag)
            ? OrderedRules
            : OrderedRules.Where(rule => rule.Tags.Contains(_selectedTag));

    private void FilterByTag(string tag) => _selectedTag = tag;
    private void ClearTag() => _selectedTag = null;

    private record WorldFaqView(
        WorldFaq Rule,
        string Title,
        string Summary,
        string Content
    ) {
        public DateTime SortDate => Rule.LastModifiedAt;
        public string Date => FormatDate(Rule.LastModifiedAt);
        public List<string> Tags => Rule.Tags;
    }

    private static string FormatDate(DateTime date)
        => date == default ? string.Empty : date.ToString("yyyy-MM-dd");
}
