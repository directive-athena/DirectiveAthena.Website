@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Localization
@using DirectiveAthenaWeb.Services.Localization.Resources
@using DirectiveAthenaWeb.Services.WorldRules
@using InfiniBlazor.Markdown
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/world-rules"
@page "/faq"

@inject IWorldRuleRepository WorldRuleRepository
@inject IWorldRuleManager WorldRuleManager
@inject ILocalizationProvider LocalizationProvider
@inject IStringLocalizer<Shared> LocalizerShared
@inject IStringLocalizer<Tags> LocalizerTags
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@LocalizerShared[Shared.WorldRulesTitle]</PageTitle>

<div class="min-vh-100 py-32">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="text-center mb-16">
            <MudText Typo="Typo.h2" Class="mb-4">@LocalizerShared[Shared.WorldRulesHeading]</MudText>
            <MudText Typo="Typo.body1" Class="text-secondary opacity-70">@LocalizerShared[Shared.WorldRulesSubtitle]
            </MudText>
        </div>

        <div class="d-flex flex-wrap justify-center gap-2 mb-12">
            <MudChip T="string" Variant="@(string.IsNullOrEmpty(_selectedTag) ? Variant.Filled : Variant.Outlined)"
                     Color="Color.Secondary" OnClick="@ClearTag">@LocalizerShared[Shared.WorldRulesAll]
            </MudChip>
            @if (_rules is not null) {
                foreach (string tag in _rules.SelectMany(r => r.Tags).Distinct()) {
                    <MudChip T="string" Variant="@(_selectedTag == tag ? Variant.Filled : Variant.Outlined)"
                             Color="Color.Secondary"
                             OnClick="@(() => FilterByTag(tag))">@LocalizerTags[tag]</MudChip>
                }
            }
        </div>

        @if (_rules is null) {
            <div class="d-flex justify-center py-12">
                <MudProgressCircular Color="Color.Secondary" Indeterminate="true" Size="Size.Large"/>
            </div>
        }
        else if (!FilteredRules.Any()) {
            <MudCard Class="card-glass pa-8 text-center border-dashed">
                <MudText Typo="Typo.h6" Class="opacity-70">@LocalizerShared[Shared.WorldRulesEmpty]</MudText>
            </MudCard>
        }
        else {
            <MudExpansionPanels MultiExpansion="true">
                @foreach (WorldRuleView rule in FilteredRules) {
                    <MudExpansionPanel Class="card-glass mb-4">
                        <TitleContent>
                            <div class="d-flex flex-column gap-2">
                                @if (!string.IsNullOrWhiteSpace(rule.Date)) {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                             Style="letter-spacing: 0.15em; text-transform: uppercase;">
                                        @string.Format(LocalizerShared[Shared.WorldRulesUpdated], rule.Date)
                                    </MudText>
                                }
                                <MudText Typo="Typo.h5" Class="SpaceGrotesk">@rule.Title</MudText>
                                @if (rule.Tags.Count > 0) {
                                    <div class="d-flex gap-1">
                                        @foreach (string tag in rule.Tags.Take(3)) {
                                            <span class="px-2 py-0 rounded"
                                                  style="background: rgba(0, 229, 255, 0.1); color: var(--neon-cyan); font-size: 0.7rem; border: 1px solid rgba(0, 229, 255, 0.2);">@LocalizerTags[tag]</span>
                                        }
                                    </div>
                                }
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudText Typo="Typo.body1" Class="text-secondary mb-6" Style="line-height: 1.7;">
                                @rule.Summary
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(rule.Content)) {
                                <div class="markdown-content">
                                    <InfiniMarkdownPreview Content="@rule.Content"/>
                                </div>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudContainer>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private List<WorldRuleView>? _rules;
    private string? _selectedTag;

    protected override async Task OnInitializedAsync() {
        IEnumerable<WorldRule> rules = await WorldRuleRepository.GetAllAsync();
        List<WorldRuleView> viewRules = new();
        string locale = LocalizationProvider.GetCurrentLocalization().Code;

        foreach (WorldRule rule in rules) {
            string content = await WorldRuleManager.GetRawMarkdownContentAsync(rule, locale);
            viewRules.Add(new WorldRuleView(
                rule,
                WorldRuleManager.GetLocalizedQuestion(rule),
                WorldRuleManager.GetLocalizedAnswer(rule),
                content));
        }

        _rules = viewRules;
    }

    private IEnumerable<WorldRuleView> OrderedRules =>
        (_rules ?? [])
        .OrderByDescending(rule => rule.SortDate)
        .ThenBy(rule => rule.Title);

    private IEnumerable<WorldRuleView> FilteredRules =>
        string.IsNullOrEmpty(_selectedTag)
            ? OrderedRules
            : OrderedRules.Where(rule => rule.Tags.Contains(_selectedTag));

    private void FilterByTag(string tag) => _selectedTag = tag;
    private void ClearTag() => _selectedTag = null;

    private  record WorldRuleView(
        WorldRule Rule,
        string Title,
        string Summary,
        string Content
    ) {
        public DateTime SortDate => RuleSortDate(Rule.Date);
        public string Date => Rule.Date;
        public List<string> Tags => Rule.Tags;
    }

    private static DateTime RuleSortDate(string? value) {
        return DateTime.TryParse(value, out DateTime parsed) ? parsed : DateTime.MinValue;
    }
}
