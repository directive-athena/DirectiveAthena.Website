@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Contact
@using DirectiveAthenaWeb.Services.Contact.Components
@using Microsoft.Extensions.Localization
@using DirectiveAthenaWeb.Client.Resources

@namespace DirectiveAthenaWeb.Client.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/contact"

@inject IStringLocalizer<Client> Localizer
@inject IContactInfoProvider ContactInfoProvider
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@Localizer[Client.ContactTitle]</PageTitle>

<div class="min-vh-100 py-32 d-flex align-center">
    <MudContainer MaxWidth="MaxWidth.Small" Class="text-center">
        <MudText Typo="Typo.h2" Class="mb-6">@Localizer[Client.ContactHeading]</MudText>
        <MudText Typo="Typo.body1" Class="text-secondary mb-12">
            @Localizer[Client.ContactSubtitle]
        </MudText>

        <MudGrid Spacing="4">
            @foreach (ContactInfoItem contactInfo in ContactInfoProvider.GetContactInfos()) {
                <MudItem xs="12">
                    <ContactInfoButon ContactInfo="@contactInfo" Class="py-4 card-glass" FullWidth/>
                </MudItem>
            }
        </MudGrid>

        <div class="mt-16">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="/"
                       StartIcon="@Icons.Material.Filled.ArrowBack">@Localizer[Client.ContactReturn]
            </MudButton>
        </div>
    </MudContainer>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

