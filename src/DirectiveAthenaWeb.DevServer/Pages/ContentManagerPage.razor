@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Content.Components
@using DirectiveAthenaWeb.DevServer.Layouts
@using DirectiveAthenaWeb.DevServer.Resources
@using DirectiveAthenaWeb.Services.Content

@namespace DirectiveAthenaWeb.DevServer.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/manager"

@inject IStringLocalizer<DevServer> Localizer
@inject IContentEditorProvider ContentEditorProvider
@inject IServiceProvider ServiceProvider

@inherits WebsiteComponentBase

@rendermode RenderMode.InteractiveServer
@layout DevServerLayout
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@Localizer[DevServer.ContentManagerTitle]</PageTitle>

<WebsiteThemeProviders/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-12">
    <div class="d-flex justify-space-between align-center mb-8">
        <MudText Typo="Typo.h3">@Localizer[DevServer.EditorHeader]</MudText>
    </div>

    <MudTabs Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" @bind-ActivePanelIndex="_activeTab">
        @foreach (ContentEditorInfo contentEditorInfo in ContentEditorProvider.GetEditors()) {
            <MudTabPanel Text="@contentEditorInfo.GetTitle(ServiceProvider)" Icon="@contentEditorInfo.Icon">
                <DynamicComponent Type="@contentEditorInfo.Type"></DynamicComponent>
            </MudTabPanel>
        }

        <MudTabPanel Text="@Localizer[DevServer.EditorTabTags]" Icon="@Icons.Material.Filled.Label">
            <TagsEditor/>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private int _activeTab;
}
