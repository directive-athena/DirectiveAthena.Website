@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Content.Faq
@using DirectiveAthenaWeb.Content.Writing
@using DirectiveAthenaWeb.DevServer.Layouts
@using DirectiveAthenaWeb.Services.Localization.Resources
@using DirectiveAthenaWeb.Services.Content
@using System.Threading

@namespace DirectiveAthenaWeb.DevServer.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/manager"

@inject IWritingContentRepository WritingRepository
@inject IWritingContentManager WritingManager
@inject IFaqContentRepository WorldFaqRepository
@inject IFaqContentManager WorldFaqManager
@inject IDirectiveAthenaWebJs WebJs
@inject ISnackbar Snackbar
@inject IStringLocalizer<Shared> Localizer

@inherits WebsiteComponentBase

@rendermode RenderMode.InteractiveServer
@layout DevServerLayout
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<PageTitle>@Localizer[Shared.ContentManagerTitle]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-12">
    <div class="d-flex justify-space-between align-center mb-8">
        <MudText Typo="Typo.h3">@Localizer[Shared.ContentManagerHeading]</MudText>
    </div>

    @if (_writings is null || _faq is null) {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    }
    else {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6"
                 @bind-ActivePanelIndex="_activeTab">
            <MudTabPanel Text="@Localizer[Shared.ContentManagerTabWritings]" Icon="@Icons.Material.Filled.Article">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudStack Spacing="3">
                            <WritingList Posts="_writings" SelectedPost="_selectedWriting"
                                         OnPostSelected="OnPostSelected" OnCreatePost="CreateNewPost"/>

                            <MudPaper Class="pa-4 card-glass no-hover">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle1">@Localizer[Shared.ContentManagerActions]</MudText>
                                    <MudSwitch T="bool" @bind-Value="AutoSaveEnabled" Color="Color.Success"
                                               Label="@Localizer[Shared.ContentManagerAutoSaveLabel]"/>
                                </div>
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudChip T="string" Color="@GetAutoSaveColor(_articleAutoSaveStatus)"
                                             Variant="Variant.Filled" Icon="@GetAutoSaveIcon(_articleAutoSaveStatus)">
                                        @GetAutoSaveStatusText(_articleAutoSaveStatus, _articleLastSavedAt)
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Class="opacity-70">
                                        @GetAutoSaveDetailText(_articleAutoSaveStatus)
                                    </MudText>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_articleAutoSaveError)) {
                                    <MudText Typo="Typo.caption" Color="Color.Warning">@_articleAutoSaveError</MudText>
                                }
                                <MudDivider Class="my-3"/>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                           OnClick="@SaveAllWritings"
                                           StartIcon="@Icons.Material.Filled.Save" Class="mb-3">
                                    @Localizer[Shared.ContentManagerSaveIndex]
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                           OnClick="@ExportWritingsJson"
                                           StartIcon="@Icons.Material.Filled.Download" Class="mb-3">
                                    @Localizer[Shared.ContentManagerDownloadIndex]
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true"
                                           OnClick="@CopyWritingsJson"
                                           StartIcon="@Icons.Material.Filled.ContentCopy">
                                    @Localizer[Shared.ContentManagerCopyIndex]
                                </MudButton>
                            </MudPaper>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="8">
                        @if (_selectedWriting is not null) {
                            <WritingEditor Post="_selectedWriting" OnDeletePost="DeletePost"
                                           OnGenerateStubs="GenerateWritingStubs"
                                           OnTagsChanged="OnTagsChanged"
                                           OnContentChanged="OnWritingChanged"/>
                        }
                        else {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                @Localizer[Shared.ContentManagerSelectPost]
                            </MudAlert>
                        }
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="@Localizer[Shared.ContentManagerTabWorldFaq]" Icon="@Icons.Material.Filled.Rule">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudStack Spacing="3">
                            <FaqList Rules="_faq" SelectedRule="_selectedFaq"
                                           OnRuleSelected="OnRuleSelected" OnCreateRule="CreateNewRule"/>

                            <MudPaper Class="pa-4 card-glass no-hover">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle1">@Localizer[Shared.ContentManagerActions]</MudText>
                                    <MudSwitch T="bool" @bind-Value="AutoSaveEnabled" Color="Color.Success"
                                               Label="@Localizer[Shared.ContentManagerAutoSaveLabel]"/>
                                </div>
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudChip T="string" Color="@GetAutoSaveColor(_ruleAutoSaveStatus)"
                                             Variant="Variant.Filled" Icon="@GetAutoSaveIcon(_ruleAutoSaveStatus)">
                                        @GetAutoSaveStatusText(_ruleAutoSaveStatus, _ruleLastSavedAt)
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Class="opacity-70">
                                        @GetAutoSaveDetailText(_ruleAutoSaveStatus)
                                    </MudText>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_ruleAutoSaveError)) {
                                    <MudText Typo="Typo.caption" Color="Color.Warning">@_ruleAutoSaveError</MudText>
                                }
                                <MudDivider Class="my-3"/>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                           OnClick="@SaveAllRules"
                                           StartIcon="@Icons.Material.Filled.Save" Class="mb-3">
                                    @Localizer[Shared.ContentManagerSaveIndex]
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                           OnClick="@ExportRulesJson"
                                           StartIcon="@Icons.Material.Filled.Download" Class="mb-3">
                                    @Localizer[Shared.ContentManagerDownloadIndex]
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true"
                                           OnClick="@CopyRulesJson"
                                           StartIcon="@Icons.Material.Filled.ContentCopy">
                                    @Localizer[Shared.ContentManagerCopyIndex]
                                </MudButton>
                            </MudPaper>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="8">
                        @if (_selectedFaq is not null) {
                            <FaqEditor Rule="_selectedFaq" OnDeleteRule="DeleteRule"
                                             OnGenerateStubs="GenerateRuleStubs"
                                             OnTagsChanged="OnTagsChanged"
                                             OnContentChanged="OnRuleChanged"/>
                        }
                        else {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                @Localizer[Shared.ContentManagerSelectRule]
                            </MudAlert>
                        }
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="@Localizer[Shared.ContentManagerTabTags]" Icon="@Icons.Material.Filled.Label">
                <TagsEditor UsedTags="@AllTags"/>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private List<WritingContent>? _writings;
    private WritingContent? _selectedWriting;
    private List<FaqContent>? _faq;
    private FaqContent? _selectedFaq;
    private int _activeTab;

    private bool _autoSaveEnabled = true;
    private bool AutoSaveEnabled {
        get => _autoSaveEnabled;
        set => OnAutoSaveToggled(value);
    }

    private AutoSaveStatus _articleAutoSaveStatus = AutoSaveStatus.Idle;
    private AutoSaveStatus _ruleAutoSaveStatus = AutoSaveStatus.Idle;
    private DateTimeOffset? _articleLastSavedAt;
    private DateTimeOffset? _ruleLastSavedAt;
    private string? _articleAutoSaveError;
    private string? _ruleAutoSaveError;
    private bool _articleHasUnsavedChanges;
    private bool _ruleHasUnsavedChanges;
    private CancellationTokenSource? _articleAutoSaveCts;
    private CancellationTokenSource? _ruleAutoSaveCts;

    private IEnumerable<string> AllTags =>
        (_writings ?? [])
        .SelectMany(post => post.Tags)
        .Concat((_faq ?? []).SelectMany(rule => rule.Tags))
        .Distinct();

    protected override async Task OnInitializedAsync() {
        IEnumerable<WritingContent> posts = await WritingRepository.GetAllAsync(QueryConfig.WithHidden | QueryConfig.WithSoftDeleted);
        _writings = posts.ToList();

        IEnumerable<FaqContent> faq = await WorldFaqRepository.GetAllAsync(QueryConfig.WithHidden | QueryConfig.WithSoftDeleted);
        _faq = faq.ToList();
    }

    private void OnPostSelected(WritingContent? post) {
        _selectedWriting = post;
    }

    private void CreateNewPost() {
        _selectedWriting = WritingManager.NewWriting();
        _writings?.Insert(0, _selectedWriting);
        OnWritingChanged();
    }

    private void OnRuleSelected(FaqContent? rule) {
        _selectedFaq = rule;
    }

    private void CreateNewRule() {
        _selectedFaq = WorldFaqManager.NewRule();
        _faq?.Insert(0, _selectedFaq);
        OnRuleChanged();
    }

    private async Task DeletePost() {
        if (_selectedWriting is null || _writings is null) return;

        bool hardDelete = _selectedWriting.IsSoftDeleted;
        string confirmText = hardDelete
            ? Localizer[Shared.ContentManagerDeletePostHardConfirm].Value
            : Localizer[Shared.ContentManagerDeletePostSoftConfirm].Value;
        bool confirm = await WebJs.ConfirmAsync(confirmText);
        if (!confirm) return;

        if (!hardDelete) {
            DateTime now = DateTime.UtcNow;
            _selectedWriting.SoftDeletedAt = now;
            _selectedWriting.LastModifiedAt = now;

            bool softDeleted = await WritingRepository.SoftDeleteByIdAsync(_selectedWriting.Id);
            if (!softDeleted && _writings is not null) {
                softDeleted = await WritingRepository.SaveAsync(_writings);
            }
            Snackbar.Add(
                softDeleted
                    ? Localizer[Shared.ContentManagerDeletePostSoftSuccess]
                    : Localizer[Shared.ContentManagerDeletePostSoftFailed],
                softDeleted ? Severity.Success : Severity.Warning);
            return;
        }

        WritingContent postToDelete = _selectedWriting;
        _writings.Remove(postToDelete);
        _selectedWriting = null;

        bool success = await WritingRepository.HardDeleteByIdAsync(postToDelete.Id);
        if (success) {
            Snackbar.Add(Localizer[Shared.ContentManagerDeletePostHardSuccess], Severity.Success);
        }
        else {
            Snackbar.Add(Localizer[Shared.ContentManagerDeletePostHardFailed], Severity.Warning);
        }
    }

    private async Task DeleteRule() {
        if (_selectedFaq is null || _faq is null) return;

        bool hardDelete = _selectedFaq.IsSoftDeleted;
        string confirmText = hardDelete
            ? Localizer[Shared.ContentManagerDeleteRuleHardConfirm].Value
            : Localizer[Shared.ContentManagerDeleteRuleSoftConfirm].Value;
        bool confirm = await WebJs.ConfirmAsync(confirmText);
        if (!confirm) return;

        if (!hardDelete) {
            DateTime now = DateTime.UtcNow;
            _selectedFaq.SoftDeletedAt = now;
            _selectedFaq.LastModifiedAt = now;

            bool softDeleted = await WorldFaqRepository.SoftDeleteByIdAsync(_selectedFaq.Id);
            if (!softDeleted && _faq is not null) {
                softDeleted = await WorldFaqRepository.SaveAsync(_faq);
            }
            Snackbar.Add(
                softDeleted
                    ? Localizer[Shared.ContentManagerDeleteRuleSoftSuccess]
                    : Localizer[Shared.ContentManagerDeleteRuleSoftFailed],
                softDeleted ? Severity.Success : Severity.Warning);
            return;
        }

        FaqContent ruleToDelete = _selectedFaq;
        _faq.Remove(ruleToDelete);
        _selectedFaq = null;

        bool success = await WorldFaqRepository.HardDeleteByIdAsync(ruleToDelete.Id);
        if (success) {
            Snackbar.Add(Localizer[Shared.ContentManagerDeleteRuleHardSuccess], Severity.Success);
        }
        else {
            Snackbar.Add(Localizer[Shared.ContentManagerDeleteRuleHardFailed], Severity.Warning);
        }
    }

    private async Task SaveAllWritings()
        => _ = await SaveAllWritingsInternal(showFeedback: true);

    private async Task SaveAllRules()
        => _ = await SaveAllRulesInternal(showFeedback: true);

    private async Task ExportWritingsJson() {
        if (_writings is null) return;

        if (!WritingManager.Validate(_writings, out string? errorMessage)) {
            Snackbar.Add(errorMessage!, Severity.Error);
            return;
        }

        await WritingRepository.SaveAsync(_writings);
        string json = await WritingRepository.GetAsJsonStringAsync();
        await DownloadFile("index.json", json);
    }

    private async Task ExportRulesJson() {
        if (_faq is null) return;

        if (!WorldFaqManager.Validate(_faq, out string? errorMessage)) {
            Snackbar.Add(errorMessage!, Severity.Error);
            return;
        }

        await WorldFaqRepository.SaveAsync(_faq);
        string json = await WorldFaqRepository.GetAsJsonStringAsync();
        await DownloadFile("index.json", json);
    }

    private async Task CopyWritingsJson() {
        if (_writings is null) return;

        string json = await WritingRepository.GetAsJsonStringAsync();
        await WebJs.CopyToClipboardAsync(json);
        Snackbar.Add(Localizer[Shared.ContentManagerJsonCopied], Severity.Success);
    }

    private async Task CopyRulesJson() {
        if (_faq is null) return;

        string json = await WorldFaqRepository.GetAsJsonStringAsync();
        await WebJs.CopyToClipboardAsync(json);
        Snackbar.Add(Localizer[Shared.ContentManagerJsonCopied], Severity.Success);
    }

    private async Task GenerateWritingStubs(bool writeToDisk) {
        if (_selectedWriting is null) return;

        (Dictionary<string, string> Stubs, bool WroteAll) result = await WritingManager.GenerateStubsAsync(_selectedWriting, writeToDisk);

        if (writeToDisk) {
            Snackbar.Add(result.WroteAll ? Localizer[Shared.ContentManagerMarkdownStubsSaved] : Localizer[Shared.ContentManagerIndexSaveFailed], result.WroteAll ? Severity.Success : Severity.Error);
            return;
        }

        foreach (KeyValuePair<string, string> stub in result.Stubs) {
            await DownloadFile($"{stub.Key}/{_selectedWriting.MarkdownFileName}", stub.Value);
        }
    }

    private async Task GenerateRuleStubs(bool writeToDisk) {
        if (_selectedFaq is null) return;

        (Dictionary<string, string> Stubs, bool WroteAll) result = await WorldFaqManager.GenerateStubsAsync(_selectedFaq, writeToDisk);

        if (writeToDisk) {
            Snackbar.Add(result.WroteAll ? Localizer[Shared.ContentManagerMarkdownStubsSaved] : Localizer[Shared.ContentManagerIndexSaveFailed], result.WroteAll ? Severity.Success : Severity.Error);
            return;
        }

        foreach (KeyValuePair<string, string> stub in result.Stubs) {
            await DownloadFile($"{stub.Key}/{_selectedFaq.MarkdownFileName}", stub.Value);
        }
    }

    private async Task DownloadFile(string fileName, string content) {
        await WebJs.DownloadFileAsync(fileName, content);
    }

    private void OnTagsChanged() {
        StateHasChanged();
    }

    private void OnWritingChanged() {
        _articleHasUnsavedChanges = true;
        _articleAutoSaveStatus = AutoSaveStatus.Pending;
        _articleAutoSaveError = null;
        ScheduleWritingAutoSave();
    }

    private void OnRuleChanged() {
        _ruleHasUnsavedChanges = true;
        _ruleAutoSaveStatus = AutoSaveStatus.Pending;
        _ruleAutoSaveError = null;
        ScheduleRuleAutoSave();
    }

    private void OnAutoSaveToggled(bool enabled) {
        _autoSaveEnabled = enabled;
        if (!enabled) {
            _articleAutoSaveCts?.Cancel();
            _ruleAutoSaveCts?.Cancel();
            StateHasChanged();
            return;
        }

        if (_articleHasUnsavedChanges) {
            ScheduleWritingAutoSave();
        }

        if (_ruleHasUnsavedChanges) {
            ScheduleRuleAutoSave();
        }
    }

    private void ScheduleWritingAutoSave() {
        if (!_autoSaveEnabled || _writings is null) return;

        _articleAutoSaveCts?.Cancel();
        _articleAutoSaveCts = new CancellationTokenSource();
        CancellationToken token = _articleAutoSaveCts.Token;

        _ = Task.Run(async () => {
            try {
                await Task.Delay(TimeSpan.FromSeconds(2), token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(AutoSaveWritingsAsync);
            }
            catch (TaskCanceledException) {
            }
        }, token);
    }

    private void ScheduleRuleAutoSave() {
        if (!_autoSaveEnabled || _faq is null) return;

        _ruleAutoSaveCts?.Cancel();
        _ruleAutoSaveCts = new CancellationTokenSource();
        CancellationToken token = _ruleAutoSaveCts.Token;

        _ = Task.Run(async () => {
            try {
                await Task.Delay(TimeSpan.FromSeconds(2), token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(AutoSaveRulesAsync);
            }
            catch (TaskCanceledException) {
            }
        }, token);
    }

    private async Task AutoSaveWritingsAsync() {
        if (!_autoSaveEnabled || !_articleHasUnsavedChanges) return;

        _articleAutoSaveStatus = AutoSaveStatus.Saving;
        StateHasChanged();
        await SaveAllWritingsInternal(showFeedback: false);
        StateHasChanged();
    }

    private async Task AutoSaveRulesAsync() {
        if (!_autoSaveEnabled || !_ruleHasUnsavedChanges) return;

        _ruleAutoSaveStatus = AutoSaveStatus.Saving;
        StateHasChanged();
        await SaveAllRulesInternal(showFeedback: false);
        StateHasChanged();
    }

    private async Task<bool> SaveAllWritingsInternal(bool showFeedback) {
        if (_writings is null) return false;

        if (!WritingManager.Validate(_writings, out string? errorMessage)) {
            _articleAutoSaveStatus = AutoSaveStatus.Paused;
            _articleAutoSaveError = errorMessage;
            if (showFeedback) {
                Snackbar.Add(errorMessage!, Severity.Error);
            }
            return false;
        }

        bool success = await WritingRepository.SaveAsync(_writings);
        if (success) {
            _articleHasUnsavedChanges = false;
            _articleAutoSaveStatus = AutoSaveStatus.Saved;
            _articleLastSavedAt = DateTimeOffset.Now;
            _articleAutoSaveError = null;
            if (showFeedback) {
                Snackbar.Add(Localizer[Shared.ContentManagerIndexSaved], Severity.Success);
            }
        }
        else {
            _articleAutoSaveStatus = AutoSaveStatus.Error;
            _articleAutoSaveError = Localizer[Shared.ContentManagerAutoSaveFailed].Value;
            if (showFeedback) {
                Snackbar.Add(Localizer[Shared.ContentManagerIndexSaveFailed], Severity.Error);
            }
        }

        return success;
    }

    private async Task<bool> SaveAllRulesInternal(bool showFeedback) {
        if (_faq is null) return false;

        if (!WorldFaqManager.Validate(_faq, out string? errorMessage)) {
            _ruleAutoSaveStatus = AutoSaveStatus.Paused;
            _ruleAutoSaveError = errorMessage;
            if (showFeedback) {
                Snackbar.Add(errorMessage!, Severity.Error);
            }
            return false;
        }

        bool success = await WorldFaqRepository.SaveAsync(_faq);
        if (success) {
            _ruleHasUnsavedChanges = false;
            _ruleAutoSaveStatus = AutoSaveStatus.Saved;
            _ruleLastSavedAt = DateTimeOffset.Now;
            _ruleAutoSaveError = null;
            if (showFeedback) {
                Snackbar.Add(Localizer[Shared.ContentManagerIndexSaved], Severity.Success);
            }
        }
        else {
            _ruleAutoSaveStatus = AutoSaveStatus.Error;
            _ruleAutoSaveError = Localizer[Shared.ContentManagerAutoSaveFailed].Value;
            if (showFeedback) {
                Snackbar.Add(Localizer[Shared.ContentManagerIndexSaveFailed], Severity.Error);
            }
        }

        return success;
    }

    private Color GetAutoSaveColor(AutoSaveStatus status) {
        if (!_autoSaveEnabled) return Color.Default;

        return status switch {
            AutoSaveStatus.Saved => Color.Success,
            AutoSaveStatus.Saving => Color.Info,
            AutoSaveStatus.Pending => Color.Warning,
            AutoSaveStatus.Paused => Color.Warning,
            AutoSaveStatus.Error => Color.Error,
            _ => Color.Default
        };
    }

    private string GetAutoSaveIcon(AutoSaveStatus status) {
        if (!_autoSaveEnabled) return Icons.Material.Filled.PauseCircle;

        return status switch {
            AutoSaveStatus.Saved => Icons.Material.Filled.CheckCircle,
            AutoSaveStatus.Saving => Icons.Material.Filled.Sync,
            AutoSaveStatus.Pending => Icons.Material.Filled.Schedule,
            AutoSaveStatus.Paused => Icons.Material.Filled.Warning,
            AutoSaveStatus.Error => Icons.Material.Filled.Error,
            _ => Icons.Material.Filled.Save
        };
    }

    private string GetAutoSaveStatusText(AutoSaveStatus status, DateTimeOffset? lastSavedAt) {
        if (!_autoSaveEnabled) return Localizer[Shared.ContentManagerAutoSaveOff];

        return status switch {
            AutoSaveStatus.Saving => Localizer[Shared.ContentManagerAutoSaveSaving],
            AutoSaveStatus.Pending => Localizer[Shared.ContentManagerAutoSaveScheduled],
            AutoSaveStatus.Paused => Localizer[Shared.ContentManagerAutoSavePaused],
            AutoSaveStatus.Error => Localizer[Shared.ContentManagerAutoSaveFailed],
            AutoSaveStatus.Saved => string.Format(Localizer[Shared.ContentManagerAutoSaveSaved], FormatTimeStamp(lastSavedAt)),
            _ => Localizer[Shared.ContentManagerAutoSaveOn]
        };
    }

    private string GetAutoSaveDetailText(AutoSaveStatus status) {
        if (!_autoSaveEnabled) return Localizer[Shared.ContentManagerAutoSaveDetailOff];

        return status switch {
            AutoSaveStatus.Saved => Localizer[Shared.ContentManagerAutoSaveDetailSaved],
            AutoSaveStatus.Paused => Localizer[Shared.ContentManagerAutoSaveDetailPaused],
            _ => Localizer[Shared.ContentManagerAutoSaveDetailReady]
        };

    }

    private static string FormatTimeStamp(DateTimeOffset? timestamp)
        => timestamp?.ToLocalTime().ToString("HH:mm") ?? "--:--";

    private enum AutoSaveStatus {
        Idle,
        Pending,
        Saving,
        Saved,
        Paused,
        Error
    }
}
