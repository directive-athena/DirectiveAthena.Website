@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Components.Pages
@using DirectiveAthenaWeb.DevServer.Layouts

@namespace DirectiveAthenaWeb.DevServer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Directive Athena</title>
    <meta name="description" content="A cosmic-themed portfolio and writing site dedicated to Directive Athena."/>
    <meta name="theme-color" content="#0A0E1C"/>
    
    <!-- Favicons -->
    <link rel="icon" type="image/png" href="assets/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="assets/favicon.svg" />
    <link rel="shortcut icon" href="assets/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Directive Athena" />
    <link rel="manifest" href="assets/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="https://directiveathena.com/"/>
    <meta property="og:title" content="Directive Athena"/>
    <meta property="og:description"
          content="A cosmic-themed portfolio and writing site dedicated to Directive Athena."/>
    <meta property="og:image" content="https://directiveathena.com/assets/social-preview.png"/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image"/>
    <meta property="twitter:url" content="https://directiveathena.com/"/>
    <meta property="twitter:title" content="Directive Athena"/>
    <meta property="twitter:description"
          content="A cosmic-themed portfolio and writing site dedicated to Directive Athena."/>
    <meta property="twitter:image" content="https://directiveathena.com/assets/social-preview.png"/>

    <base href="/"/>
    
    <link rel="stylesheet" href="css/app.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet"/>
    <link href="DirectiveAthenaWeb.Client.styles.css" rel="stylesheet"/>
    <link rel="stylesheet" href="_content/InfiniLore.InfiniBlazor/InfiniBlazor.css" />
    
    <script type="importmap"></script>
    
    <HeadOutlet/>
</head>
<body>

<Router AppAssembly="@typeof(AdminApp).Assembly" NotFoundPage="@typeof(NotFoundPage)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(DevServerLayout)"/>
    </Found>
</Router>

<script src="_content/InfiniLore.InfiniBlazor/InfiniBlazor.js"></script>
<script src="_framework/blazor.web.js"></script>
<script src="_content/MudBlazor/MudBlazor.min.js"></script>
<script src="js/interop.bundle.min.js"></script>
</body>
</html>

@* ------------------------------------------------------------------------------------------------------------------ *@
