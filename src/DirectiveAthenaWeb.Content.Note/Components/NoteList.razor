@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Content.Note
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
@* <ContentEditorListView TContent="NoteContent" *@
@*              Items="Notes" *@
@*              SelectedItem="SelectedNote" *@
@*              OnSelected="OnNoteSelected" *@
@*              OnCreate="OnCreateNote" *@
@*              HeaderText="@Localizer[Shared.ListNotes]" *@
@*              GetTitle="GetTitle" *@
@*              LocalizationMaps="GetLocalizationMaps" *@
@*              ShowHiddenChip="true"/> *@

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public List<NoteContent>? Notes { get; set; }
    [Parameter] public NoteContent? SelectedNote { get; set; }
    [Parameter] public EventCallback<NoteContent?> OnNoteSelected { get; set; }
    [Parameter] public EventCallback OnCreateNote { get; set; }

    private string GetTitle(NoteContent note)
        => note.Title.GetValueOrDefault("en") ?? Localizer[Shared.ListUntitled];

    private IEnumerable<Dictionary<string, string>> GetLocalizationMaps(NoteContent note)
        => [note.Title, note.Summary];
}
