@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Content.Note
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-4 card-glass mb-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">@Localizer[Shared.ListNotes]</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@OnCreateNote"/>
    </div>
    <MudList T="NoteContent" SelectedValue="SelectedNote" SelectedValueChanged="OnNoteSelected"
             Color="Color.Primary">
        @if (Notes is not null) {
            foreach (NoteContent post in Notes) {
                <MudListItem Value="post">
                    <div class="d-flex flex-column">
                        <MudText
                            Typo="Typo.body1">@(post.Title.GetValueOrDefault("en") ?? Localizer[Shared.ListUntitled])</MudText>
                        <MudText Typo="Typo.caption" Class="opacity-50">@post.Id.ToString("D")</MudText>
                        <div class="d-flex align-center gap-1">
                            @if (post.IsSoftDeleted) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.Delete">@Localizer[Shared.ListDeleted]</MudChip>
                            }
                            @if (post.IsHidden) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.VisibilityOff">@Localizer[Shared.ListHidden]</MudChip>
                            }
                            @if (string.IsNullOrEmpty(post.Title.GetValueOrDefault("nl")) || string.IsNullOrEmpty(post.Summary.GetValueOrDefault("nl"))) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                         Variant="Variant.Text">@Localizer[Shared.ListMissingNl]
                                </MudChip>
                            }
                        </div>
                    </div>
                </MudListItem>
            }
        }
    </MudList>
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public List<NoteContent>? Notes { get; set; }
    [Parameter] public NoteContent? SelectedNote { get; set; }
    [Parameter] public EventCallback<NoteContent?> OnNoteSelected { get; set; }
    [Parameter] public EventCallback OnCreateNote { get; set; }
}
