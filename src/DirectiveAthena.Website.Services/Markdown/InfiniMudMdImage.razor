@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using InfiniBlazor.Markdown.Parsers.Blazor
@using InfiniBlazor.Markdown.Syntax.Nodes

@namespace DirectiveAthena.Website.Services.Markdown
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inherits InfiniBlazorMdComponentBase<ImageMdSyntaxNode>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudImage
    Src="@SyntaxNode.Href"
    Alt="@SyntaxNode.NormalizedAltText"
    UserAttributes="@GetAttributes()"
    Elevation="2"
    Class="rounded-lg"
/>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private Dictionary<string, object> GetAttributes() {
        var attrs = new Dictionary<string, object>();
        string? title = GetTitle();
        if (title != null) attrs["title"] = title;
        attrs["style"] = GetStyle();
        return attrs;
    }

    private const string FitStyling = "width:auto;height:1em;vertical-align:text-top;object-fit:contain;transform:translate(0,0.15em);";

    private string GetStyle() {
        var styles = new List<string>();
        if (SyntaxNode.Modifier is not {} modifier) return "max-width: 100%; height: auto;";

        if (modifier.TryGetAlign(out string? align)) {
            styles.Add($"vertical-align:{align}");
        }

        if (modifier.TryGetFit(out bool state) && state) {
            styles.Add(FitStyling);
        }

        if (modifier.TryGetSize(out (int Width, int Height) size)) {
            styles.Add($"width:{size.Width}px;height:{size.Height}px;");
        } else {
             styles.Add("max-width: 100%; height: auto;");
        }

        return string.Join(";", styles);
    }

    private string? GetTitle() {
        if (SyntaxNode.Title.IsNotNullOrWhiteSpace()) return SyntaxNode.Title;
        if (SyntaxNode.Modifier != null && SyntaxNode.Modifier.TryGetTitle(out string? title)) return title;
        return null;   
    }
}
