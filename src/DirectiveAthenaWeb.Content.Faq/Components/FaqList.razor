@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Content.Faq
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Content.Faq.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
@* <ContentEditorListView TContent="FaqContent" *@
@*              Items="Rules" *@
@*              SelectedItem="SelectedRule" *@
@*              OnSelected="OnRuleSelected" *@
@*              OnCreate="OnCreateRule" *@
@*              HeaderText="@Localizer[Shared.ListRules]" *@
@*              GetTitle="GetTitle" *@
@*              LocalizationMaps="GetLocalizationMaps"/> *@

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public List<FaqContent>? Rules { get; set; }
    [Parameter] public FaqContent? SelectedRule { get; set; }
    [Parameter] public EventCallback<FaqContent?> OnRuleSelected { get; set; }
    [Parameter] public EventCallback OnCreateRule { get; set; }

    private string GetTitle(FaqContent rule)
        => rule.Question.GetValueOrDefault("en") ?? Localizer[Shared.ListUntitled];

    private IEnumerable<Dictionary<string, string>> GetLocalizationMaps(FaqContent rule)
        => [rule.Question, rule.Answer];
}
