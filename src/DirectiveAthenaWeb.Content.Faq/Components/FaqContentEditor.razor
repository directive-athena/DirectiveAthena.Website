@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Content.Faq
@using DirectiveAthenaWeb.Services.Localization

@namespace DirectiveAthenaWeb.DevServer.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<ContentEditor TContent="@FaqContent">
    <Fields Context="content">
        <MudSwitch T="bool" @bind-Value="@content.ShowOnHomepage"
                   Label="Show On Homepage" Color="Color.Secondary"/>
    </Fields>
    <LocalizedFields Context="context">
        @{ FaqContent content = context.Content;LocalizationInfo culture = context.Culture; }
        <MudTextField Label="Title" Variant="Variant.Filled"
                      @bind-Value="@content.Question[culture.Code]"
                      Required="true"
                      FullWidth="true"/>
        <MudTextField Label="Summary" Variant="Variant.Filled"
                      @bind-Value="@content.Answer[culture.Code]"
                      FullWidth="true"/>
    </LocalizedFields>
</ContentEditor>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
}
