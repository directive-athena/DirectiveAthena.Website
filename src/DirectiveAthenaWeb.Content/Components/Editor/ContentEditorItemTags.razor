@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Content.Resources


@* ReSharper disable once CheckNamespace *@
@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Editor> EditorLocalizer

@typeparam TContent where TContent : ContentBase
@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudItem xs="12">
    <MudDivider Class="my-4"/>
    <MudText Typo="Typo.subtitle1" Color="Color.Primary">@EditorLocalizer[Editor.TagsTitle]</MudText>
    <div class="d-flex flex-wrap gap-2 mb-2">
        @foreach (string tag in Content.Tags) {
            <MudChip T="string" OnClose="@(() => RemoveTagAsync(tag))" Color="Color.Secondary"
                     Variant="Variant.Filled">@tag</MudChip>
        }
    </div>
    <div class="d-flex gap-2">
        <MudTextField @bind-Value="_newTag" Label="@EditorLocalizer[Editor.AddTag]"
                      OnKeyDown="@OnTagKey"/>
        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="@AddTagAsync"/>
    </div>
    <MudText Typo="Typo.caption" Class="mt-1 d-block">
        @EditorLocalizer[Editor.TagsHint]
    </MudText>
</MudItem>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter] public TContent Content { get; set; } = null!;
    [Parameter] public EventCallback OnTagsChanged { get; set; }

    private string _newTag = string.Empty;

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    private async Task AddTagAsync() {
        if (_newTag.IsNullOrWhiteSpace()) return;

        string trimmedTag = _newTag.Trim();
        if (!Content.AddTag(trimmedTag)) return; // TODO state for when the tag could not be added? Snackbar stuff etc
        
        _newTag = string.Empty;
        
        await OnTagsChanged.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveTagAsync(string tag) {
        if (!Content.RemoveTag(tag)) return; // TODO state for when the tag could not be removed? Snackbar stuff etc
        
        await OnTagsChanged.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnTagKey(KeyboardEventArgs e) {
        if (e.Key != "Enter") return;
        await AddTagAsync();
    }
}
