@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Content.Resources

@* ReSharper disable once CheckNamespace *@
@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Editor> Localizer

@typeparam TContent where TContent : ContentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-4 card-glass mb-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">Items</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@OnCreate"/>
    </div>
    <MudList T="TContent" SelectedValue="SelectedItem" SelectedValueChanged="OnSelected" Color="Color.Secondary">
        @foreach (TContent item in Items) {
            <MudListItem Value="item">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">@item.GetReadableInternalTitle()</MudText>
                    <MudText Typo="Typo.caption" Class="opacity-50">@item.Id.ToString("D")</MudText>
                    <MudStack Row>
                        @foreach (ChipData chip in Chips) {
                            if (chip.IsVisible(item)) {
                                <MudChip T="string" Size="Size.Small" Color="@chip.Color" Variant="Variant.Text"
                                         Icon="@chip.Icon">
                                    @Localizer[chip.LocalizedId]
                                </MudChip>
                            }
                        }
                    </MudStack>
                </div>
            </MudListItem>
        }
    </MudList>
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [CascadingParameter] public TContent[] Items { get; set; } = null!;
    [CascadingParameter] public TContent? SelectedItem { get; set; }

    [Parameter] public EventCallback<TContent?> OnSelected { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }

    private static readonly ChipData[] Chips = [
        new(
            item => item.IsSoftDeleted,
            Icons.Material.Filled.Delete,
            Editor.ListDeleted,
            Color.Error
        ),
        new(
            item => item.IsHidden,
            Icons.Material.Filled.VisibilityOff,
            Editor.ListHidden,
            Color.Default
        ),
        new(
            item => item.IsDevContent,
            Icons.Material.Filled.DeveloperMode,
            Editor.ListDevContent,
            Color.Default
        ),
    ];

    private record ChipData(Func<TContent, bool> IsVisible, string Icon, string LocalizedId, Color Color);
}
