@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Components
@using DirectiveAthenaWeb.Content.Resources
@using DirectiveAthenaWeb.Services.Js
@using DirectiveAthenaWeb.Services.Localization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using MudBlazor

@namespace DirectiveAthenaWeb.Content.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IContentRepository<TContent> Repository
@inject IDirectiveAthenaWebJs WebJs
@inject ISnackbar Snackbar
@inject IStringLocalizer<Editor> Localizer

@typeparam TContent where TContent : ContentBase
@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<CascadingValue Value="Content">
    <MudPaper Class="pa-6 card-glass no-hover">
        <div class="d-flex justify-space-between align-center mb-6">
            <MudText Typo="Typo.h5">@Localizer[Editor.EditItem, Content.GetReadableInternalTitle()]</MudText>
            <MudStack Row Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="@OnSaveChangesAsync">
                    @Localizer[Editor.SaveItemButton]
                </MudButton>
                
                @if (!Content.IsSoftDeleted) {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="@SoftDeleteContentAsync">
                        @Localizer[Editor.DeleteItemButton]
                    </MudButton>
                }
                else {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Restore"
                               OnClick="@RestoreContentAsync">
                        @Localizer[Editor.RestoreItemButton]
                    </MudButton>
                    
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="@HardDeleteContentAsync">
                        @Localizer[Editor.HardDeleteItemButton]
                    </MudButton>
                }
            </MudStack>
        </div>

        <MudTabs Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <MudTabPanel Text="Metadata">
                <MudStack Spacing="8">
                    <MudTextField T="string" @bind-Value="@Content.InternalTitle" Label="@Localizer[Editor.InternalTitle]" TextChanged="@OnInputChangedAsync"/>

                    <MudTextField Value="@Content.Id.ToString("D")" Label="@Localizer[Editor.UniqueId]"
                                  Required="true" ReadOnly="true"
                                  HelperText="@Localizer[Editor.IdHelperItem]"/>

                    <MudTextField Value="@FormatDate(Content.CreatedAt)" Label="@Localizer[Editor.CreatedAtLabel]"
                                  Required="true" ReadOnly="true"/>

                    <MudTextField Value="@FormatDate(Content.LastModifiedAt)"
                                  Label="@Localizer[Editor.LastModifiedAtLabel]"
                                  Required="true" ReadOnly="true"/>

                    <MudSwitch T="bool" Value="@Content.IsHidden" ValueChanged="@OnHiddenChangedAsync"
                               Label="@Localizer[Editor.HiddenLabel]" Color="Color.Primary"/>

                    <MudSwitch T="bool" Value="@Content.IsDevContent" ValueChanged="@OnDevContentChangedAsync"
                               Label="@Localizer[Editor.DevContentLabel]" Color="Color.Primary"/>
                    
                    @if (Fields is not null) {
                        @Fields
                    }

                    @if (LocalizedFields is not null) {
                        foreach (LocalizationInfo culture in LocalizationProvider.GetSupportedLocalizations()) {
                            <MudItem xs="12">
                                <MudDivider Class="my-4"/>
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary">
                                    @culture.DisplayName (@culture.Code)
                                </MudText>
                                @LocalizedFields((Content, culture))
                            </MudItem>
                        }
                    }
                </MudStack>

                <ContentEditorItemTags TContent="@TContent" OnTagsChanged="OnSaveChangesAsync"/>
            </MudTabPanel>

            <MudTabPanel Text="Markdown">
                <ContentEditorItemMarkdown TContent="@TContent" OnFileChanged="OnSaveChangesAsync"/>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>

</CascadingValue>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter, EditorRequired] public TContent Content { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment<(TContent, LocalizationInfo)>? LocalizedFields { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TContent>? Fields { get; set; }
    [Parameter] public EventCallback OnContentChanged { get; set; }

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    private async Task OnHiddenChangedAsync(bool value) {
        DateTime now = DateTime.UtcNow;
        Content.HiddenAt = value ? now : DateTime.MinValue;
        Content.LastModifiedAt = now;
        await OnSaveChangesAsync();
    }
    
    private async Task OnDevContentChangedAsync(bool value) {
        DateTime now = DateTime.UtcNow;
        Content.IsDevContent = value;
        Content.LastModifiedAt = now;
        await OnSaveChangesAsync();
    }

    private async Task SoftDeleteContentAsync() {
        if (!await WebJs.ConfirmAsync(Localizer[Editor.DeleteItemSoftConfirm])) return;

        DateTime now = DateTime.UtcNow;
        Content.SoftDeletedAt = now;
        Content.LastModifiedAt = now;

        if (!await Repository.SoftDeleteByIdAsync(Content.Id)) {
            Snackbar.Add(Localizer[Editor.DeleteItemSoftFailed], Severity.Warning);
            return;
        }
        
        Snackbar.Add(Localizer[Editor.DeleteItemSoftSuccess], Severity.Success);
        await Repository.SaveAsync();
        await OnContentChanged.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RestoreContentAsync() {
        if (!await Repository.RestoreByIdAsync(Content.Id)) {
            Snackbar.Add(Localizer[Editor.RestoreItemFailed], Severity.Warning);
            return;
        }
        
        Snackbar.Add(Localizer[Editor.RestoreItemSuccess], Severity.Success);
        await Repository.SaveAsync();
        await OnContentChanged.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task HardDeleteContentAsync() {
        if (!await WebJs.ConfirmAsync(Localizer[Editor.DeleteItemHardConfirm])) return;
        
        if (!await Repository.HardDeleteByIdAsync(Content.Id)) {
            Snackbar.Add(Localizer[Editor.DeleteItemHardFailed], Severity.Warning);
            return;
        }
        
        Snackbar.Add(Localizer[Editor.DeleteItemHardSuccess], Severity.Success);
        await Repository.SaveAsync();
        await OnContentChanged.InvokeAsync();
    }

    private static string FormatDate(DateTime date)
        => date == DateTime.MinValue ? string.Empty : date.ToString("yyyy-MM-dd");

    private async Task OnSaveChangesAsync() {
        var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        try {
            bool result = await Repository.AddOrUpdateAsync(Content, cts.Token);

            if (result) {
                Snackbar.Add(Localizer[Editor.SaveItemSuccess], Severity.Success);
                await Repository.SaveAsync(cts.Token);
                await OnContentChanged.InvokeAsync();
            }
            else {
                Snackbar.Add(Localizer[Editor.SaveItemFailed], Severity.Error);
            }

        }
        catch (Exception e) {
            Logger.Error(e, "Failed to save content.");
            Snackbar.Add(Localizer[Editor.SaveItemFailed], Severity.Error);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnInputChangedAsync(string obj) {
        if (Content.InternalTitle.Equals(obj, StringComparison.Ordinal)) return;
        
        Content.InternalTitle = obj;
        await OnSaveChangesAsync();
    }
}
