@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Components
@using DirectiveAthenaWeb.Services.Content
@using DirectiveAthenaWeb.Services.Js
@using DirectiveAthenaWeb.Content.Resources
@using DirectiveAthenaWeb.Services.Localization
@using Microsoft.Extensions.Localization
@using MudBlazor

@namespace DirectiveAthenaWeb.Content.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IContentRepository<TContent> Repository
@inject IDirectiveAthenaWebJs WebJs
@inject ISnackbar Snackbar
@inject IStringLocalizer<Editor> Localizer
@inject IContentManager<TContent> ContentManager

@typeparam TContent where TContent : ContentBase
@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<CascadingValue Value="Items">
    <CascadingValue Value="SelectedItem">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudStack>
                    <MudPaper Class="pa-4 card-glass no-hover">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudText Typo="Typo.subtitle1">@Localizer[Editor.ContentManagerActions]</MudText>
                        </div>
                        <MudDivider Class="my-3"/>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                   OnClick="@SaveIndexAsync"
                                   StartIcon="@Icons.Material.Filled.Save" Class="mb-3">
                            @Localizer[Editor.ContentManagerSaveIndex]
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                   OnClick="@DownloadIndexAsync"
                                   StartIcon="@Icons.Material.Filled.Download" Class="mb-3">
                            @Localizer[Editor.ContentManagerDownloadIndex]
                        </MudButton>
                    </MudPaper>
                    
                    <ContentEditorListView TContent="@TContent" OnSelected="@OnItemSelectedAsync"
                                           OnCreate="@OnCreateAsync"/>
                </MudStack>
            </MudItem>

            @if (SelectedItem is not null) {
                <MudItem xs="12" md="8">
                    <ContentEditorItem TContent="@TContent"
                                       Content="SelectedItem"
                                       Fields="@Fields"
                                       LocalizedFields="@LocalizedFields"
                                       OnContentChanged="@OnContentChangedAsync"/>
                </MudItem>
            }
        </MudGrid>
    </CascadingValue>
</CascadingValue>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private TContent[] Items { get; set; } = [];
    private TContent? SelectedItem { get; set; }

    [Parameter] public RenderFragment<(TContent, LocalizationInfo)>? LocalizedFields { get; set; }
    [Parameter] public RenderFragment<TContent>? Fields { get; set; }

    private const QueryConfig BaseConfig = QueryConfig.WithHidden | QueryConfig.WithSoftDeleted | QueryConfig.SortByCreatedAt;
    
    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        Items = await Repository.GetAllAsync(BaseConfig.AddEnvironmentFlags());
    }

    private async Task OnItemSelectedAsync(TContent? selectedItem) {
        SelectedItem = selectedItem;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCreateAsync() {
        SelectedItem = ContentManager.Create();
        await Repository.AddOrUpdateAsync(SelectedItem);

        Items = await Repository.GetAllAsync(BaseConfig.AddEnvironmentFlags());
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveIndexAsync()
        => _ = await SaveIndexInternalAsync(showFeedback: true);

    private async Task DownloadIndexAsync() {
        if (!await SaveIndexInternalAsync(showFeedback: true)) return;

        string json = await Repository.GetAsJsonStringAsync();
        await DownloadFileAsync("index.json", json);
    }

    private async Task<bool> SaveIndexInternalAsync(bool showFeedback) {
        if (!ContentManager.Validate(Items, out string? errorMessage)) {
            if (showFeedback) {
                Snackbar.Add(errorMessage!, Severity.Error);
            }
            return false;
        }

        await Repository.AddOrUpdateRangeAsync(Items);
        bool success = await Repository.SaveAsync();
        if (showFeedback) {
            Snackbar.Add(Localizer[success ? Editor.ContentManagerIndexSaved : Editor.ContentManagerIndexSaveFailed],
                success ? Severity.Success : Severity.Error);
        }

        return success;
    }

    private async Task DownloadFileAsync(string fileName, string content) {
        await WebJs.DownloadFileAsync(fileName, content);
    }
    
    private async Task OnContentChangedAsync() {
        Items = await Repository.GetAllAsync(BaseConfig.AddEnvironmentFlags());
        
        // Check if the current selected item is still valid
        if (SelectedItem != null && Items.All(item => item.Id != SelectedItem.Id)) {
            SelectedItem = null;
        }
        
        await InvokeAsync(StateHasChanged);
    }
}
