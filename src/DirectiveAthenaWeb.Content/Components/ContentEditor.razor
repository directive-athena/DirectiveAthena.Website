@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private TContent[] Items { get; set; } = [];
    private TContent? SelectedItem { get; set; }
    
    const QueryConfig Config = QueryConfig.WithHidden | QueryConfig.WithSoftDeleted | QueryConfig.SortByCreatedAt;

    // -----------------------------------------------------------------------------------------------------------------
    // Methods
    // -----------------------------------------------------------------------------------------------------------------
    protected override async Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        Items = await Repository.GetAllAsync(Config);
    }

    private async Task OnItemSelectedAsync(TContent? selectedItem) {
        SelectedItem = selectedItem;
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task OnCreateAsync() {
        SelectedItem = ContentManager.Create();
        await Repository.AddOrUpdateAsync(SelectedItem);

        Items = await Repository.GetAllAsync(Config);
        await InvokeAsync(StateHasChanged);
    }
}
