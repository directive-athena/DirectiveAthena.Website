@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Localization
@using System.Globalization

@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IDirectiveAthenaWebJs WebJs
@inject NavigationManager NavigationManager

@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Dense="true" Class="ml-2">
    <ActivatorContent>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="@context.ToggleAsync">
            <div class="d-flex align-center gap-2">
                @if (!string.IsNullOrEmpty(CurrentCulture.FlagPath)) {
                    <img src="@CurrentCulture.FlagPath" alt="@CurrentCulture.Abbreviation"
                         style="width: 24px; height: auto;"/>
                }
                else {
                    <MudBadge Content="@CurrentCulture.Abbreviation" Color="Color.Primary" Overlap="false"/>
                }
                <MudText>@CurrentCulture.Abbreviation</MudText>
            </div>
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        @foreach (LocalizationInfo culture in LocalizationProvider.GetSupportedLocalizations()) {
            <MudMenuItem OnClick="@(() => ChangeCulture(culture.Code))">
                <div class="d-flex align-center gap-2">
                    @if (culture.FlagPath.IsNotNullOrWhiteSpace()) {
                        <img src="@culture.FlagPath" alt="@culture.DisplayName" style="width: 24px; height: auto;"/>
                    }
                    else {
                        <MudBadge Content="@culture.Abbreviation" Color="Color.Secondary" Overlap="false"/>
                    }
                    <MudText>@culture.DisplayName</MudText>
                </div>
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private async Task ChangeCulture(string culture) {
        if (CultureInfo.CurrentUICulture.TwoLetterISOLanguageName != culture) {
            await WebJs.SetLocalStorageItemAsync("culture", culture);
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
    }

}
