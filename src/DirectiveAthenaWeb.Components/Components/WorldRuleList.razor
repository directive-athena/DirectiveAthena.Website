@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Localization.Resources
@using DirectiveAthenaWeb.Services.WorldRules
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-4 card-glass mb-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">@Localizer[Shared.ListRules]</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@OnCreateRule"/>
    </div>
    <MudList T="WorldRule" SelectedValue="SelectedRule" SelectedValueChanged="OnRuleSelected"
             Color="Color.Primary">
        @if (Rules is not null) {
            foreach (WorldRule rule in Rules) {
                <MudListItem Value="rule">
                    <div class="d-flex flex-column">
                        <MudText
                            Typo="Typo.body1">@(rule.Question.GetValueOrDefault("en") ?? Localizer[Shared.ListUntitled])</MudText>
                        <MudText Typo="Typo.caption" Class="opacity-50">@rule.Id.ToString("D")</MudText>
                        <div class="d-flex align-center gap-1">
                            @if (rule.IsSoftDeleted) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.Delete">@Localizer[Shared.ListDeleted]</MudChip>
                            }
                            @if (string.IsNullOrEmpty(rule.Question.GetValueOrDefault("nl")) || string.IsNullOrEmpty(rule.Answer.GetValueOrDefault("nl"))) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                         Variant="Variant.Text">@Localizer[Shared.ListMissingNl]
                                </MudChip>
                            }
                        </div>
                    </div>
                </MudListItem>
            }
        }
    </MudList>
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public List<WorldRule>? Rules { get; set; }
    [Parameter] public WorldRule? SelectedRule { get; set; }
    [Parameter] public EventCallback<WorldRule?> OnRuleSelected { get; set; }
    [Parameter] public EventCallback OnCreateRule { get; set; }
}
