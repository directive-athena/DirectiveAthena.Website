@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Content
@using DirectiveAthenaWeb.Services.Localization
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject ILocalizationProvider LocalizationProvider
@inject IStringLocalizer<Shared> Localizer

@typeparam TContent where TContent : IContent
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-4 card-glass mb-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h6">@HeaderText</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@OnCreate"/>
    </div>
    <MudList T="TContent" SelectedValue="SelectedItem" SelectedValueChanged="OnSelected" Color="Color.Primary">
        @if (Items is not null) {
            foreach (TContent item in Items) {
                <MudListItem Value="item">
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body1">@GetTitle(item)</MudText>
                        <MudText Typo="Typo.caption" Class="opacity-50">@item.Id.ToString("D")</MudText>
                        <div class="d-flex align-center gap-1">
                            @if (ShowDeletedChip && item.IsSoftDeleted) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Icon="@Icons.Material.Filled.Delete">
                                    @Localizer[Shared.ListDeleted]
                                </MudChip>
                            }
                            @if (ShowHiddenChip && item.IsHidden) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Icon="@Icons.Material.Filled.VisibilityOff">
                                    @Localizer[Shared.ListHidden]
                                </MudChip>
                            }
                            @if (HasMissingLocalizations(item)) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                         @Localizer[Shared.ListMissingNl]
                                </MudChip>
                            }
                        </div>
                    </div>
                </MudListItem>
            }
        }
    </MudList>
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public IList<TContent>? Items { get; set; }
    [Parameter] public TContent? SelectedItem { get; set; }
    [Parameter] public EventCallback<TContent?> OnSelected { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter, EditorRequired] public string HeaderText { get; set; } = "";
    [Parameter, EditorRequired] public Func<TContent, string> GetTitle { get; set; } = null!;
    [Parameter] public Func<TContent, IEnumerable<Dictionary<string, string>>>? LocalizationMaps { get; set; }
    [Parameter] public bool ShowHiddenChip { get; set; }
    [Parameter] public bool ShowDeletedChip { get; set; } = true;

    private bool HasMissingLocalizations(TContent item) {
        if (LocalizationMaps is null) return false;

        IEnumerable<Dictionary<string, string>> maps = LocalizationMaps(item);
        IEnumerable<Dictionary<string, string>> enumerable = maps as Dictionary<string, string>[] ?? maps.ToArray();

        foreach (LocalizationInfo localization in LocalizationProvider.GetSupportedLocalizations()) {
            string code = localization.Code;
            foreach (Dictionary<string, string> map in enumerable) {
                if (!map.TryGetValue(code, out string? value) || string.IsNullOrWhiteSpace(value)) {
                    return true;
                }
            }
        }

        return false;
    }
}
