@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Contact
@using DirectiveAthenaWeb.Services.Contact.Components
@using DirectiveAthenaWeb.Components.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Components> Localizer
@inject IContactInfoProvider ContactInfoProvider
@inject HttpClient Http
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<footer class="mt-12 py-12">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Justify="Justify.SpaceBetween">
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center mb-4">
                    <MudImage Src="assets/logo-color.svg" Width="32" Height="32" Alt="Logo" Class="mr-3"/>
                    <MudText Typo="Typo.h6" Class="SpaceGrotesk">@Localizer[Components.BrandName]</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="text-secondary">
                    @Localizer[Components.FooterDescription]
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex justify-sm-end align-center">
                @foreach (ContactInfoItem contactInfo in ContactInfoProvider.GetContactInfos()) {
                    if (!contactInfo.IncludeInFooter) continue;
                    <ContactInfoIconButon ContactInfo="@contactInfo"/>
                }
            </MudItem>
        </MudGrid>
        <MudDivider Class="my-8 opacity-10"/>
        <MudText Typo="Typo.caption" Class="d-block opacity-60" Align="Align.Center">
            @Localizer[Components.FooterCopyright, DateTime.UtcNow.Year]
        </MudText>
        <MudText Typo="Typo.caption" Class="d-block opacity-50" Align="Align.Center">
            @Localizer[Components.FooterVersion, _version]
        </MudText>
    </MudContainer>
</footer>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private string _version = "0";

    protected override async Task OnInitializedAsync() {
        try {
            string versionText = await Http.GetStringAsync("version.txt");
            string trimmed = versionText.Trim();
            if (!trimmed.IsNullOrWhiteSpace()) {
                _version = trimmed;
            }
        }
        catch {
            _version = "unknown";
        }
    }
}
