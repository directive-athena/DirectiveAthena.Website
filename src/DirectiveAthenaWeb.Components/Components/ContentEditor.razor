@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Content
@using DirectiveAthenaWeb.Services.ContentStorage
@using DirectiveAthenaWeb.Services.Localization
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors *@
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IContentRepository<TContent> Repository
@inject IDirectiveAthenaWebJs WebJs
@inject ISnackbar Snackbar
@inject IStringLocalizer<Editor> EditorLocalizer

@typeparam TContent where TContent : ContentBase
@inherits WebsiteComponentBase
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html *@
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper Class="pa-6 card-glass no-hover">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h5">@EditorLocalizer[Editor.EditItem, Content.Id.ToString("D")]</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                       OnClick="@DeleteContentAsync"/>
    </div>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField Value="@Content.Id.ToString("D")" Label="@EditorLocalizer[Editor.UniqueId]"
                          Required="true" ReadOnly="true"
                          HelperText="@EditorLocalizer[Editor.IdHelperItem]"/>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField Value="@FormatDate(Content.CreatedAt)" Label="@EditorLocalizer[Editor.CreatedAtLabel]"
                          Required="true" ReadOnly="true"/>
        </MudItem>
        @if (ShowLastModified) {
            <MudItem xs="12" md="6">
                <MudTextField Value="@FormatDate(Content.LastModifiedAt)"
                              Label="@EditorLocalizer[Editor.LastModifiedAtLabel]"
                              Required="true" ReadOnly="true"/>
            </MudItem>
        }
        @if (ShowHiddenToggle) {
            <MudItem xs="12">
                <MudSwitch T="bool" Value="@Content.IsHidden" ValueChanged="@OnHiddenChanged"
                           Label="@EditorLocalizer[Editor.HiddenLabel]" Color="Color.Primary"/>
            </MudItem>
        }
        @if (AdditionalFields is not null) {
            @AdditionalFields
        }

        
        @foreach (LocalizationInfo culture in LocalizationProvider.GetSupportedLocalizations()) {
            <MudItem xs="12">
                <MudDivider Class="my-4"/>
                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@culture.DisplayName (@culture.Code)</MudText>
                @LocalizedFields(culture)
            </MudItem>
        }
        

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <MudTextField Value="@Content.MarkdownFileName"
                          Label="@EditorLocalizer[Editor.MarkdownFileLabel, Content.MarkdownFileName]"
                          Required="true" ReadOnly="true"
                          HelperText="@EditorLocalizer[Editor.MarkdownFileHelper]"/>
        </MudItem>

        @if (ShowTags) {
            <MudItem xs="12">
                <MudDivider Class="my-4"/>
                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@EditorLocalizer[Editor.TagsTitle]</MudText>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (string tag in Tags) {
                        <MudChip T="string" OnClose="@(() => RemoveTag(tag))" Color="Color.Secondary"
                                 Variant="Variant.Filled">@tag</MudChip>
                    }
                </div>
                <div class="d-flex gap-2">
                    <MudTextField @bind-Value="_newTag" Label="@EditorLocalizer[Editor.AddTag]"
                                  OnKeyDown="@OnTagKey"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="@AddTag"/>
                </div>
                <MudText Typo="Typo.caption" Class="mt-1 d-block">
                    @EditorLocalizer[Editor.TagsHint]
                </MudText>
            </MudItem>
        }

        <MudItem xs="12">
            <MudDivider Class="my-4"/>
            <LocalizedMarkdownEditor Title="@EditorLocalizer[Editor.MarkdownLabel]"
                                     FileName="@Content.MarkdownFileName"
                                     Storage="@Storage"
                                     LoadContentAsync="@LoadContentAsync"
                                     BuildDefaultContent="@BuildDefaultContent"/>
        </MudItem>

        <MudItem xs="12" Class="mt-4">
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Info"
                           OnClick="@(() => OnGenerateStubs.InvokeAsync(true))"
                           StartIcon="@Icons.Material.Filled.NoteAdd">
                    @EditorLocalizer[Editor.MarkdownStubsSaveDisk]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Info"
                           OnClick="@(() => OnGenerateStubs.InvokeAsync(false))"
                           StartIcon="@Icons.Material.Filled.Download">
                    @EditorLocalizer[Editor.MarkdownStubsDownload]
                </MudButton>
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code *@
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter, EditorRequired] public TContent Content { get; set; } = null!;
    [Parameter, EditorRequired] public IList<string> Tags { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment<LocalizationInfo> LocalizedFields { get; set; } = null!;
    [Parameter] public RenderFragment? AdditionalFields { get; set; }
    [Parameter] public bool AlwaysShowLastModified { get; set; }
    [Parameter] public bool ShowHiddenToggle { get; set; }
    [Parameter] public bool ShowTags { get; set; } = true;
    [Parameter] public IContentStorage? Storage { get; set; }
    [Parameter] public Func<string, Task<string>>? LoadContentAsync { get; set; }
    [Parameter] public Func<string, string>? BuildDefaultContent { get; set; }
    [Parameter] public EventCallback<bool> OnGenerateStubs { get; set; }
    [Parameter] public EventCallback OnTagsChanged { get; set; }
    [Parameter] public EventCallback OnContentChanged { get; set; }
    [Parameter] public EventCallback<ContentDeleteResult<TContent>> OnDeleted { get; set; }

    private string _newTag = "";
    private bool ShowLastModified => AlwaysShowLastModified || Content.LastModifiedAt != DateTime.MinValue;

    private void AddTag() {
        if (string.IsNullOrWhiteSpace(_newTag)) return;

        string trimmedTag = _newTag.Trim();
        if (Tags.Contains(trimmedTag)) {
            _newTag = "";
            return;
        }

        Tags.Add(trimmedTag);
        TouchLastModified();
        _newTag = "";
        NotifyTagsChanged();
        NotifyContentChanged();
    }

    private void RemoveTag(string tag) {
        Tags.Remove(tag);
        TouchLastModified();
        NotifyTagsChanged();
        NotifyContentChanged();
    }

    private void OnTagKey(KeyboardEventArgs e) {
        if (e.Key == "Enter") AddTag();
    }

    private void OnHiddenChanged(bool value) {
        DateTime now = DateTime.UtcNow;
        Content.HiddenAt = value ? now : DateTime.MinValue;
        Content.LastModifiedAt = now;
        NotifyContentChanged();
    }

    private void TouchLastModified() {
        Content.LastModifiedAt = DateTime.UtcNow;
    }

    private void NotifyTagsChanged() {
        if (OnTagsChanged.HasDelegate) {
            _ = OnTagsChanged.InvokeAsync();
        }
    }

    private void NotifyContentChanged() {
        if (OnContentChanged.HasDelegate) {
            _ = OnContentChanged.InvokeAsync();
        }
    }

    private async Task DeleteContentAsync() {
        bool hardDelete = Content.IsSoftDeleted;
        string confirmText = hardDelete ? EditorLocalizer[Editor.DeleteItemHardConfirm] : EditorLocalizer[Editor.DeleteItemSoftConfirm];
        bool confirm = await WebJs.ConfirmAsync(confirmText);
        if (!confirm) return;

        if (!hardDelete) {
            DateTime now = DateTime.UtcNow;
            Content.SoftDeletedAt = now;
            Content.LastModifiedAt = now;

            bool softDeleted = await Repository.SoftDeleteByIdAsync(Content.Id);
            Snackbar.Add(
                softDeleted ? EditorLocalizer[Editor.DeleteItemSoftSuccess] : EditorLocalizer[Editor.DeleteItemSoftFailed],
                softDeleted ? Severity.Success : Severity.Warning);
            NotifyContentChanged();
            return;
        }

        bool success = await Repository.HardDeleteByIdAsync(Content.Id);
        Snackbar.Add(
            success ? EditorLocalizer[Editor.DeleteItemHardSuccess] : EditorLocalizer[Editor.DeleteItemHardFailed],
            success ? Severity.Success : Severity.Warning);
        await OnDeleted.InvokeAsync(new ContentDeleteResult<TContent>(Content, true, success));
    }

    private static string FormatDate(DateTime date)
        => date == DateTime.MinValue ? string.Empty : date.ToString("yyyy-MM-dd");
}
