@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Components.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Components> Localizer
@inject NavigationManager NavigationManager
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudContainer MaxWidth="MaxWidth.Large">
    <MudStack Spacing="4">
        <MudItem>
            <MudText Typo="Typo.h2" Class="mb-4">@Localizer[Components.HomeLiveTitle]</MudText>
            <MudStack Row>

                <MudText Typo="Typo.body1"
                         Class="text-secondary opacity-70">@Localizer[Components.HomeLiveSubtitle]</MudText>
                <MudSpacer/>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.OpenInNew"
                           Href="https://twitch.tv/AnnaSasDev"
                           Target="_blank">@Localizer[Components.HomeLiveFollow]</MudButton>
            </MudStack>
        </MudItem>
        <MudItem>
            <div class="twitch-container card-glass twitch-aspect-ratio no-hover">
                <iframe
                    src="https://player.twitch.tv/?channel=AnnaSasDev&parent=@HostName&muted=true&autoplay=false"
                    loading="lazy"
                    allowfullscreen="allowfullscreen">
                </iframe>
            </div>
        </MudItem>
    </MudStack>
</MudContainer>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private string HostName { get; set; } = "localhost";

    protected override void OnInitialized() {
        base.OnInitialized();

        // Extract hostname for Twitch embed parent requirement
        var uri = new Uri(NavigationManager.BaseUri);
        HostName = uri.Host;
    }
}
