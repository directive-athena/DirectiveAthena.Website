@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer
@inject NavigationManager NavigationManager
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<section id="live" class="py-24" style="background: rgba(100, 65, 165, 0.1);">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="text-center mb-12">
            <MudText Typo="Typo.h2" Class="mb-4">@Localizer[Shared.HomeLiveTitle]</MudText>
            <MudText Typo="Typo.body1" Class="text-secondary opacity-70">@Localizer[Shared.HomeLiveSubtitle]</MudText>
        </div>
        <div class="twitch-wrapper">
            <div class="twitch-container card-glass twitch-aspect-ratio">
                <iframe
                    src="https://player.twitch.tv/?channel=AnnaSasDev&parent=@HostName&muted=true&autoplay=false"
                    loading="lazy"
                    allowfullscreen="allowfullscreen">
                </iframe>
            </div>
        </div>
        <div class="mt-8 text-center">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.OpenInNew"
                       Href="https://twitch.tv/AnnaSasDev" Target="_blank">@Localizer[Shared.HomeLiveFollow]</MudButton>
        </div>
    </MudContainer>
</section>

@code {
    private string HostName { get; set; } = "localhost";

    protected override void OnInitialized() {
        base.OnInitialized();
        
        // Extract hostname for Twitch embed parent requirement
        var uri = new Uri(NavigationManager.BaseUri);
        HostName = uri.Host;
    }
}
