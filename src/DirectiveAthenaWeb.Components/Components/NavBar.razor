@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Components
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IStringLocalizer<Shared> Localizer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudAppBar Elevation="@(IsScrolled || IsStatic ? 1 : 0)"
           Class="@(IsScrolled || IsStatic ? "appbar-glass scrolled" : "appbar-glass")"
           Fixed="true">

    @if (OnMenuClick.HasDelegate) {
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@OnMenuClick" Class="mr-2"/>
    }
    
    <MudImage Src="assets/logo-whiteShaded.svg" Width="32" Height="32" Alt="Logo" Class="mr-3"/>

    <MudButton Variant="Variant.Text" Href="/" Class="@(IsScrolled || IsStatic ? "brand-text d-none d-sm-flex" : "brand-text")">
        @Localizer[Shared.BrandName]
    </MudButton>

    <MudSpacer/>

    <CultureSelector/>
</MudAppBar>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    [Parameter] public bool IsStatic { get; set; }
    [Parameter] public bool IsScrolled { get; set; }
    [Parameter] public EventCallback OnMenuClick { get; set; }
}
