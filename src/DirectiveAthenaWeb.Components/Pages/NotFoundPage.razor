@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Services.Localization.Resources
@using Microsoft.Extensions.Localization

@namespace DirectiveAthenaWeb.Components.Pages
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/not-found"
@inject IStringLocalizer<Shared> Localizer
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<section class="d-flex align-center justify-center min-vh-100">
    <MudContainer MaxWidth="MaxWidth.Small" Class="text-center">
        <MudCard Class="card-glass pa-8 no-hover">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large"
                         Style="font-size: 4rem; opacity: 0.35;"/>

                <MudText Typo="Typo.h3" Class="SpaceGrotesk">@Localizer[Shared.NotFoundTitle]</MudText>
                <MudText Typo="Typo.body1" Class="text-secondary opacity-70" Style="max-width: 420px;">
                    @Localizer[Shared.NotFoundMessage]
                </MudText>

                <MudStack Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">
                        @Localizer[Shared.NotFoundGoHome]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/writings">
                        @Localizer[Shared.NotFoundBrowseWritings]
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudCard>
    </MudContainer>
</section>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
