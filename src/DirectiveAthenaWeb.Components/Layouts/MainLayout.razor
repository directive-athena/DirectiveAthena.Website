@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using DirectiveAthenaWeb.Components
@using DirectiveAthenaWeb.Services.ContentStorage

@namespace DirectiveAthenaWeb.Components.Layouts
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@inject IDirectiveAthenaWebJs WebJs
@inject IR2StatusTracker R2Status

@inherits LayoutComponentBase
@implements IDisposable
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<WebsiteThemeProviders/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout Class="min-vh-100 d-flex flex-column">
    <BackgroundLayer/>

    <NavBar IsScrolled="_isScrolled" OnMenuClick="@(_ => _drawerOpen = !_drawerOpen)"/>

    <DrawerMenu @bind-Open="_drawerOpen"/>

    <MudMainContent Class="relative flex-grow-1 d-flex flex-column">
        @if (R2Status.IsFallbackActive) {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mx-6 mt-6 mb-2">
                R2 is unreachable in development; using in-memory content until it reconnects.
            </MudAlert>
        }
        <div class="flex-grow-1">
            @Body
        </div>

        <PageFooter/>
    </MudMainContent>
</MudLayout>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@

@code {
    private bool _drawerOpen;
    private bool _isScrolled;
    private DotNetObjectReference<MainLayout>? _objRef;

    protected override void OnInitialized() {
        R2Status.StatusChanged += OnStatusChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            _objRef = DotNetObjectReference.Create(this);
            await WebJs.RegisterScrollListenerAsync(_objRef);
        }
    }

    [JSInvokable]
    public void OnScroll(double scrollY) {
        bool scrolled = scrollY > 50;

        if (scrolled == _isScrolled) return;

        _isScrolled = scrolled;
        StateHasChanged();
    }

    private void OnStatusChanged() {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() {
        _objRef?.Dispose();
        R2Status.StatusChanged -= OnStatusChanged;
    }

}
